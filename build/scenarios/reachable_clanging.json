{
  "query": "?map=8&x=9&y=16&frames=90",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"check": "$gameScreen.weatherType()", "expect": "none",
     "label": "the world map is dry to start with"},
    {"key": "ArrowUp", "times": 4},
    {"check": "$gameMap._interpreter.isRunning()", "expect": true,
     "label": "walking onto the town icon starts the town event"},
    {"advance": 25},
    {"frames": 60},
    {"check": "$gameMap.mapId()", "expect": 21,
     "label": "'Go in' arrives in Upper Clanging"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [17, 41],
     "label": "at the foot of the street, inside the gate"},
    {"check": "$gameSwitches.value(47)", "expect": true,
     "label": "and SW_NORTH is set"},
    {"check": "$gameScreen.weatherType()", "expect": "rain",
     "label": "the map's own autorun has started the rain"},

    {"key": "ArrowUp", "times": 27},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [17, 14],
     "label": "the street is walkable end to end, up both flights of steps"},
    {"shot": "clanging_street.png"},

    {"key": "ArrowUp", "times": 1},
    {"frames": 90},
    {"check": "$gameMap.mapId()", "expect": 22,
     "label": "the works door opens"},
    {"check": "$gameScreen.weatherType()", "expect": "none",
     "label": "and it stops raining indoors"},
    {"key": "ArrowDown", "times": 2},
    {"frames": 90},
    {"check": "$gameMap.mapId()", "expect": 21, "label": "and out again"},
    {"check": "$gameScreen.weatherType()", "expect": "rain",
     "label": "into the rain"},

    {"eval": "$gamePlayer.locate(25, 29)"},
    {"key": "ArrowUp", "times": 3},
    {"frames": 90},
    {"check": "$gameMap.mapId()", "expect": 23,
     "label": "the Safety Valve door opens"},
    {"check": "$gameScreen.weatherType()", "expect": "none"},
    {"key": "ArrowDown", "times": 2},
    {"frames": 90},
    {"check": "$gameMap.mapId()", "expect": 21, "label": "and out again"},

    {"eval": "$gamePlayer.locate(7, 30)"},
    {"key": "ArrowUp", "times": 3},
    {"frames": 90},
    {"check": "$gameMap.mapId()", "expect": 24,
     "label": "Ollerenshaw's door opens"},
    {"check": "$gameScreen.weatherType()", "expect": "none"},
    {"key": "ArrowDown", "times": 2},
    {"frames": 90},
    {"check": "$gameMap.mapId()", "expect": 21, "label": "and out again"},

    {"eval": "$gamePlayer.locate(21, 40)"},
    {"key": "ArrowRight", "times": 3},
    {"key": "ArrowUp", "times": 1},
    {"frames": 90},
    {"check": "$gameMap.mapId()", "expect": 25,
     "label": "the Parish Rooms door opens"},
    {"check": "$gameScreen.weatherType()", "expect": "none"},
    {"key": "ArrowDown", "times": 2},
    {"frames": 90},
    {"check": "$gameMap.mapId()", "expect": 21, "label": "and out again"},

    {"eval": "$gamePlayer.locate(17, 41)"},
    {"key": "ArrowDown", "times": 1},
    {"check": "$gameMap._interpreter.isRunning()", "expect": true,
     "label": "the gate at the foot of the street answers"},
    {"advance": 25},
    {"frames": 90},
    {"check": "$gameMap.mapId()", "expect": 8,
     "label": "and puts you back on the west road"},
    {"check": "$gameScreen.weatherType()", "expect": "none",
     "label": "with the rain left behind in Upper Clanging"}
  ]
}
