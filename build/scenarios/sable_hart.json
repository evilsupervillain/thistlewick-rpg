{
  "query": "?map=8&x=24&y=76&frames=90",
  "comment": "SITES.md step 12, walked: onto the Sable Hart's door off the world map from the sand south of it, in, Crake in the Secretary's corner (a trope, counted once), Crake again, Crake with Corvin in the party (the reaction shot, not COR-3, and no ranking in it), Rook, Mrs Garrow at the bar, Blackwood by the fire, the league table - which stops at fourth - and the rota, Veyle in the darkest corner twice, the empty table, Morrow, the newsletter, and back out onto places.SABLE_HART_STEP. Walked rather than started by hand, because the door is a placeholder replaced and only arriving proves the swap landed on the right square; every event is reached with the action button from the square a player would stand on, checked by $gameMap._interpreter.eventId().",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"eval": "window._tropes = $gameVariables.value(2); window._blushes = $gameVariables.value(7); window._lines = []; const add = Game_Message.prototype.add; Game_Message.prototype.add = function (t) { window._lines.push(t); return add.call(this, t); }"},
    {"check": "$gameMap.mapId()", "expect": 8},
    {"check": "$dataMap.events.filter(e => e && e.name === 'Sable Hart').map(e => [e.x, e.y, e.pages[0].trigger, e.pages[0].priorityType, (e.note||'').includes('-site')])",
     "expect": [[24, 75, 1, 0, false]],
     "label": "one real door on the House (Town) stamp's one cell: player-touch, below characters, and no longer a placeholder"},

    {"comment": "One north onto the door cell.",
     "key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [24, 75],
     "label": "standing on the Sable Hart's door"},
    {"check": "$gameMap._interpreter.isRunning()", "expect": true,
     "label": "THE POINT: this door does something now"},
    {"shot": "sable_hart_door.png"},
    {"advance": 6},
    {"frames": 120},
    {"check": "$gameMap.mapId()", "expect": 49, "label": "inside the Sable Hart"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [10, 9],
     "label": "just inside the door"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},
    {"shot": "sable_hart_room.png"},

    {"comment": "Along the row between the empty tables and the south wall, to the Secretary's corner.",
     "key": "ArrowUp", "times": 1, "gap": 30},
    {"key": "ArrowLeft", "times": 7, "gap": 30},
    {"key": "ArrowUp", "times": 4, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [3, 5, 8],
     "label": "below Crake, facing him"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 2, "label": "Hollin Crake"},
    {"shot": "sable_hart_crake.png"},
    {"advance": 40},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1,
     "label": "the dark mirror is a trope - five of them, being fair about seating"},
    {"check": "$gameSelfSwitches.value([49, 2, 'A'])", "expect": true},
    {"check": "window._lines.some(l => l.includes(\"I'm not here\"))", "expect": false,
     "label": "without Corvin, no Corvin"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 2},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('give mine to Blackwood'))", "expect": true,
     "label": "the second page"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1,
     "label": "and asked again, it does not count twice"},

    {"comment": "The branch: Corvin in the party, and the first page again. The trope is counted again because A was cleared by hand; that is the harness, not the game.",
     "eval": "$gameParty.addActor(8); $gameSelfSwitches.setValue([49, 2, 'A'], false); window._lines = []"},
    {"frames": 10},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 2},
    {"advance": 50},
    {"check": "window._lines.some(l => l.includes('We have you down')) && window._lines.some(l => l.includes(\"I'm not here\"))", "expect": true,
     "label": "with Corvin: the reaction shot"},
    {"check": "window._lines.some(l => /seventeen|17th|league|rank/i.test(l))", "expect": false,
     "label": "and nothing of COR-3 spent: nobody tells him where he is on the table"},
    {"eval": "$gameParty.removeActor(8); window._tropes += 1"},

    {"comment": "Down the west wall to Rook.",
     "key": "ArrowDown", "times": 4, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [3, 8, 2],
     "label": "above Rook, facing him"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 4, "label": "Thaddeus Rook"},
    {"advance": 20},
    {"check": "window._lines.some(l => l.includes('ninety-one'))", "expect": true},

    {"comment": "Across to the end of the bar.",
     "key": "ArrowRight", "times": 6, "gap": 30},
    {"key": "ArrowUp", "times": 2, "gap": 30},
    {"key": "ArrowLeft", "times": 1, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [8, 6, 8],
     "label": "below Mrs Garrow, facing her"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 7, "label": "Mrs Garrow"},
    {"advance": 20},

    {"comment": "Blackwood, by the fire.",
     "key": "ArrowRight", "times": 3, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [11, 6, 8],
     "label": "below Blackwood, facing him"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 6, "label": "Kit Blackwood"},
    {"shot": "sable_hart_blackwood.png"},
    {"advance": 20},

    {"comment": "Over the rug to the two notices on the north wall.",
     "key": "ArrowRight", "times": 3, "gap": 30},
    {"key": "ArrowUp", "times": 2, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [14, 4, 8],
     "label": "under the league table, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 8, "label": "the league table"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('T. ROOK')) && !window._lines.some(l => /\\b5\\. /.test(l))", "expect": true,
     "label": "it stops at fourth: the rest is under the rota"},
    {"key": "ArrowRight", "times": 1, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [15, 4, 8],
     "label": "under the rota, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 9, "label": "the corner rota"},
    {"advance": 10},

    {"comment": "The darkest corner.",
     "key": "ArrowDown", "times": 1, "gap": 30},
    {"key": "ArrowRight", "times": 2, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [17, 5, 8],
     "label": "below Veyle, facing him"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 3, "label": "Silas Veyle"},
    {"shot": "sable_hart_veyle.png"},
    {"advance": 30},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 3},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('no window behind it'))", "expect": true,
     "label": "the second page: the curtain"},

    {"comment": "Down the east wall and along to the empty table.",
     "key": "ArrowDown", "times": 3, "gap": 30},
    {"key": "ArrowLeft", "times": 4, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [13, 8, 8],
     "label": "below the empty table, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 11, "label": "an empty table"},
    {"advance": 10},

    {"comment": "Morrow, in the south-east corner.",
     "key": "ArrowRight", "times": 4, "gap": 30},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [17, 8, 2],
     "label": "above Morrow, facing him"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 5, "label": "Lucan Morrow"},
    {"advance": 20},

    {"comment": "The newsletter, on his table.",
     "key": "ArrowLeft", "times": 1, "gap": 30},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [16, 8, 2],
     "label": "above the newsletter, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 10, "label": "the newsletter"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('C. Ash (as ever)'))", "expect": true,
