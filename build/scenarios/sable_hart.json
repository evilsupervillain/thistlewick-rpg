    {"comment": "And out, onto the sand.",
     "key": "ArrowLeft", "times": 6, "gap": 30},
    {"key": "ArrowDown", "times": 3, "gap": 30},
    {"frames": 150},
    {"check": "$gameMap.mapId()", "expect": 8, "label": "back on the world map"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [24, 76],
     "label": "on places.SABLE_HART_STEP, one south of the door"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1},
    {"check": "$gameVariables.value(7) - window._blushes", "expect": 0,
     "label": "and no blush: the room is warm, not red"},
    {"shot": "sable_hart_out.png"}
  ]
