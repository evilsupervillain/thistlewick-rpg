{
  "query": "?map=1&x=16&y=26&frames=90",
  "comment": "QUESTS.md A2, WRE-5 Bramus. Without Wren the burrow in the turnip rows has no page and the action button in front of it starts nothing. With her: the naming - a trope and a blush, once each - SW_WRE5_NAMED, SW_WREN_STORY and VAR_COMPANION_STORIES. Then the burrow again with her (the short page, nothing counted twice), and without her: the label, for everybody.",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"eval": "window._tropes = $gameVariables.value(2); window._blushes = $gameVariables.value(7); window._lines = []; const add = Game_Message.prototype.add; Game_Message.prototype.add = function (t) { window._lines.push(t); return add.call(this, t); }"},
    {"check": "[$gameMap.mapId(), $gamePlayer.x, $gamePlayer.y]", "expect": [1, 16, 26]},
    {"check": "[$gameMap.event(25).x, $gameMap.event(25).y]", "expect": [16, 27]},
    {"check": "$gameMap.event(25).findProperPageIndex()", "expect": -1, "label": "no burrow without Wren"},

    {"comment": "Without Wren: face the cell and press. Nothing is there to start.", "key": "ArrowDown", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [16, 27, 2], "label": "nothing blocks the row - Bram walks on to the cell"},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [16, 26]},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap.isEventRunning()", "expect": false, "label": "nothing starts without her"},
    {"check": "[$gameSwitches.value(113), $gameSwitches.value(108), $gameVariables.value(15)]", "expect": [false, false, 0]},

    {"comment": "With Wren: the burrow is there, and blocks its cell.", "eval": "$gamePlayer.locate(16, 26); $gamePlayer.setDirection(2); $gameParty.addActor(9); window._lines = []"},
    {"frames": 20},
    {"check": "$gameMap.event(25).findProperPageIndex()", "expect": 0, "label": "the naming page"},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [16, 26, 2], "label": "the burrow blocks its cell"},
    {"shot": "q_wre5_burrow.png"},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 25},
    {"shot": "q_wre5_naming.png"},
    {"advance": 60},
    {"check": "window._lines.some(l => l.includes(\"I'm naming it after you.\"))", "expect": true},
    {"check": "window._lines.some(l => l.includes('Bramus agricola'))", "expect": true},
    {"check": "window._lines.some(l => l.includes('statistically'))", "expect": true},
    {"check": "window._lines.some(l => l.includes('deeply touched'))", "expect": true},
    {"check": "$gameSwitches.value(113)", "expect": true, "label": "SW_WRE5_NAMED"},
    {"check": "$gameSwitches.value(108)", "expect": true, "label": "SW_WREN_STORY"},
    {"check": "$gameVariables.value(15)", "expect": 1, "label": "VAR_COMPANION_STORIES"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1, "label": "the honour that is an insult is a trope"},
    {"check": "$gameVariables.value(7) - window._blushes", "expect": 1, "label": "March to October is a blush"},

    {"comment": "Again, with her: the short page, and nothing counted twice.", "eval": "window._lines = []"},
    {"check": "$gameMap.event(25).findProperPageIndex()", "expect": 2},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('Still here.'))", "expect": true},
    {"check": "[$gameVariables.value(2) - window._tropes, $gameVariables.value(7) - window._blushes, $gameVariables.value(15)]", "expect": [1, 1, 1], "label": "counted once"},

    {"comment": "Without her: the label, which is there for everybody now.", "eval": "$gameParty.removeActor(9); window._lines = []"},
    {"frames": 20},
    {"check": "$gameMap.event(25).findProperPageIndex()", "expect": 1},
    {"key": "Enter"}, {"frames": 60},
    {"shot": "q_wre5_label.png"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('DO NOT PLOUGH'))", "expect": true},
    {"check": "window._lines.some(l => l.includes('Still here.'))", "expect": false},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"}
  ]
}
