{
  "query": "?map=6&x=10&y=6&frames=90",
  "comment": "QUESTS.md A5, ROL-4 The Maker's Mark. Beatrice on the anvil without Roland or Hob is what it was; Roland alone looks at the forge and nothing happens; Roland and Hob together - the mark, 'She did good work', Beatrice saying nothing, and nobody explaining the hammer - SW_ROL4_SEEN and SW_STORY[ROLAND] once; again, the short line. Then Roland gone at the tower door (his departure has its own scenario, guest_leaves: here it is its outcome - the switch, the party, and Fairweather's Own, **equipped on Bram**, which is the case the refit has to find): Hob offers the refit, is turned down, offers again, and does it - the sword off Bram's hands and gone, the axe got, Hob able to hold it and Bram not.",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"eval": "window._lines = []; const add = Game_Message.prototype.add; Game_Message.prototype.add = function (t) { window._lines.push(t); return add.call(this, t); }; window._mark = () => { window._tropes = $gameVariables.value(2); window._lines = []; }; window._mark()"},
    {"check": "[$gameMap.mapId(), $gamePlayer.x, $gamePlayer.y]", "expect": [6, 10, 6]},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [10, 6, 8]},

    {"comment": "Nobody: the hammer as it was.", "check": "$gameMap.event(4).findProperPageIndex()", "expect": 0},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 4},
    {"advance": 5},
    {"check": "window._lines.some(l => l.includes('did not just move'))", "expect": true},

    {"comment": "Roland alone.", "eval": "$gameParty.addActor(10); window._mark()"},
    {"frames": 20},
    {"check": "$gameMap.event(4).findProperPageIndex()", "expect": 1},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('the sword he never uses'))", "expect": true},
    {"check": "window._lines.some(l => /mark|aunt/.test(l))", "expect": false},
    {"check": "$gameSwitches.value(118)", "expect": false},

    {"comment": "Roland and Hob: the mark.", "eval": "$gameParty.addActor(3); window._mark()"},
    {"frames": 20},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 4},
    {"shot": "q_rol4_anvil.png"},
    {"advance": 40},
    {"check": "window._lines.some(l => l.includes(\"That's my aunt's.\"))", "expect": true},
    {"check": "window._lines.some(l => l.includes('She did good work.'))", "expect": true},
    {"check": "window._lines.some(l => l.includes('says nothing at'))", "expect": true, "label": "Beatrice says nothing"},
    {"check": "window._lines.some(l => /hammer/i.test(l))", "expect": false, "label": "nobody explains the hammer"},
    {"check": "[$gameSwitches.value(118), $gameSwitches.value(109), $gameVariables.value(15)]", "expect": [true, true, 1]},
    {"eval": "window._mark()"},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('Mind the edge'))", "expect": true},
    {"check": "$gameVariables.value(15)", "expect": 1},

    {"comment": "After the tower door: Roland gone, and his sword in Bram's hands.", "eval": "$gameParty.removeActor(10); $gameSwitches.setValue(21, true); $gameParty.gainItem($dataWeapons[30], 1); $gameActors.actor(1).changeEquip(0, $dataWeapons[30]); window._mark()"},
    {"frames": 20},
    {"check": "[$gameActors.actor(1).weapons()[0].id, $gameParty.numItems($dataWeapons[30])]", "expect": [30, 0], "label": "equipped, not carried"},
    {"check": "$gameMap.event(4).findProperPageIndex()", "expect": 2},
    {"key": "Enter"}, {"frames": 240},
    {"key": "Enter"}, {"frames": 240},
    {"key": "Enter"}, {"frames": 240},
    {"check": "SceneManager._scene._messageWindow._choiceListWindow.active", "expect": true, "label": "the choice is up"},
    {"choose": 1},
    {"advance": 5},
    {"check": "window._lines.some(l => l.includes('Fair enough.'))", "expect": true},
    {"check": "[$gameSwitches.value(119), $gameActors.actor(1).weapons()[0].id]", "expect": [false, 30], "label": "left a sword"},

    {"comment": "And again, refitted.", "eval": "window._mark()"},
    {"key": "Enter"}, {"frames": 240},
    {"key": "Enter"}, {"frames": 240},
    {"key": "Enter"}, {"frames": 240},
    {"check": "SceneManager._scene._messageWindow._choiceListWindow.active", "expect": true},
    {"choose": 0},
    {"advance": 20},
    {"check": "window._lines.some(l => l.includes(\"Handle's mine.\"))", "expect": true},
    {"check": "$gameSwitches.value(119)", "expect": true},
    {"check": "[$gameActors.actor(1).weapons().length, $gameParty.hasItem($dataWeapons[30], true), $gameParty.numItems($dataWeapons[40])]", "expect": [0, false, 1], "label": "the sword off Bram's hands and gone; the axe got"},
    {"check": "[$gameActors.actor(3).canEquip($dataWeapons[40]), $gameActors.actor(1).canEquip($dataWeapons[40])]", "expect": [true, false], "label": "Hob's, and nobody else's"},
    {"eval": "window._mark()"},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('swings right'))", "expect": true},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 0, "label": "no tropes from ROL-4"},

    {"comment": "Without Hob, afterwards: the hammer as it was.", "eval": "$gameParty.removeActor(3)"},
    {"frames": 20},
    {"check": "$gameMap.event(4).findProperPageIndex()", "expect": 0},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"}
  ]
}
