{
  "query": "?map=8&x=30&y=94&frames=90",
  "comment": "SITES.md step 4: Olde Evermore and the Forbidden Archive, one site on one Village C cell. Walked the whole way, not started by hand: onto the door off the world map, over the edge of the ledge and into the leaves, the ARRIVALS sign, the raker, down to the Archive and in, Mirabel four times - the biscuit, the horse, the secret (the blush) and bedtime - the Archive's copy of the Prophecy with the horse beside clause twelve, back out, and down the path onto places.EVERMORE_STEP.",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"eval": "window._tropes = $gameVariables.value(2); window._blushes = $gameVariables.value(7)"},
    {"check": "$gameMap.mapId()", "expect": 8},
    {"check": "$dataMap.events.filter(e => e && e.name === 'Olde Evermore').map(e => [e.name, e.x, e.y])",
     "expect": [["Olde Evermore", 30, 93]],
     "label": "one door event: Village C is one cell"},
    {"check": "$dataMap.events.filter(e => e && e.name === 'Olde Evermore').every(e => !(e.note||'').includes('-site'))",
     "expect": true,
     "label": "and it is not a placeholder any more"},

    {"comment": "One north onto the door cell. Player-touch, below characters.",
     "key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [30, 93],
     "label": "standing on Olde Evermore's door"},
    {"check": "$gameMap._interpreter.isRunning()", "expect": true,
     "label": "THE POINT: this door does something now"},
    {"shot": "evermore_door.png"},
    {"advance": 6},
    {"frames": 120},
    {"check": "$gameMap.mapId()", "expect": 38, "label": "over the edge, and into Olde Evermore"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [12, 6],
     "label": "in the leaves under the ledge"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},
    {"shot": "evermore_landing.png"},

    {"comment": "The ARRIVALS sign blocks its own cell, so it is read from the square below it.",
     "key": "ArrowDown", "times": 2, "gap": 30},
    {"key": "ArrowLeft", "times": 1, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [11, 8, 8],
     "label": "under the sign, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 3, "label": "reading ARRIVALS"},
    {"advance": 20},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1,
     "label": "the hidden elven village you find by falling off a ledge is a trope"},

    {"comment": "Across the leaves to the raker, who is at (15,6).",
     "key": "ArrowRight", "times": 3, "gap": 30},
    {"key": "ArrowUp", "times": 2, "gap": 30},
    {"key": "ArrowRight", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [14, 6, 6],
     "label": "beside the raker, facing her"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 7, "label": "talking to the raker"},
    {"advance": 20},
    {"check": "$gameSelfSwitches.value([38, 7, 'A'])", "expect": true},

    {"comment": "Down to the Archive's path and along it to the door.",
     "key": "ArrowDown", "times": 8, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [14, 14]},
    {"key": "ArrowRight", "times": 5, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [19, 14], "label": "on the Archive's step"},
    {"shot": "evermore_archive_front.png"},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 150},
    {"check": "$gameMap.mapId()", "expect": 39, "label": "inside the Forbidden Archive"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [9, 11]},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"comment": "Up the carpet to Mirabel, on her stepstool at (9,7).",
     "key": "ArrowUp", "times": 3, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [9, 8, 8],
     "label": "in front of the stepstool, facing her"},
    {"shot": "evermore_archive.png"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 2, "label": "Mirabel: the prophecy"},
    {"shot": "evermore_mirabel.png"},
    {"advance": 40},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 2,
     "label": "the child oracle and her unfinished prophecy is the second trope"},
    {"check": "$gameSelfSwitches.value([39, 2, 'A'])", "expect": true, "label": "...is that a biscuit?"},

    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 2, "label": "Mirabel: the Prophecy of Thistlewick, and the villain"},
    {"advance": 40},
    {"check": "$gameSelfSwitches.value([39, 2, 'B'])", "expect": true, "label": "it is a horse"},
    {"check": "$gameVariables.value(7) - window._blushes", "expect": 0,
     "label": "and the horse is not a blush"},

    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 2, "label": "Mirabel: a real secret, not a prophecy"},
    {"advance": 40},
    {"check": "$gameSelfSwitches.value([39, 2, 'C'])", "expect": true},
    {"check": "$gameVariables.value(7) - window._blushes", "expect": 1,
     "label": "THE BLUSH: she has known since the ninth of March, and it is going to be called Biscuit"},

    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 2, "label": "Mirabel: nearly half past seven"},
    {"advance": 20},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 2, "label": "and nothing after the first page counts twice"},
    {"check": "$gameVariables.value(7) - window._blushes", "expect": 1},

    {"comment": "Along row 8 to the Archive's copy of the Prophecy, on its table at (4,9).",
     "key": "ArrowLeft", "times": 5, "gap": 30},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [4, 8, 2],
     "label": "above the copy, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 5, "label": "the horse beside clause twelve"},
    {"shot": "evermore_copy.png"},
    {"advance": 20},

    {"comment": "Back to the carpet and out of the door.",
     "key": "ArrowRight", "times": 5, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [9, 8]},
    {"key": "ArrowDown", "times": 5, "gap": 30},
    {"frames": 120},
    {"check": "$gameMap.mapId()", "expect": 38, "label": "back out in the village"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [19, 14], "label": "on the Archive's step"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"comment": "Along the path and down it to the way out, which nobody has ever come in by.",
     "key": "ArrowLeft", "times": 6, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [13, 14]},
    {"key": "ArrowDown", "times": 9, "gap": 30},
    {"frames": 120},
    {"check": "$gameMap.mapId()", "expect": 8, "label": "back on the world map"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [30, 94],
     "label": "on places.EVERMORE_STEP, one south of the door"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},
    {"shot": "evermore_out.png"}
  ]
}
