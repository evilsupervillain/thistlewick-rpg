{
  "query": "?map=8&x=43&y=71&frames=90",
  "steps": [
    {"comment": "Mike's edits of 23 October 2026. The Bottomless Pit: the party arrives on the floor at the foot of the rope, not halfway up it, and the rope's foot is an event that blocks, so the way out is walking into it and nobody climbs past it onto the walls. The crack Mike moved to (19,2) is read from the floor below it. The Barrow: in at Mike's new mouth on the map's south edge, and the hound's alcove he set back into the wall.",
     "eval": "$gameSystem.disableEncounter()"},
    {"eval": "$gameParty.gainGold(10)", "comment": "Splint's two crowns"},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 30},
    {"check": "$gameMap._interpreter.eventId()", "expect": 10, "label": "into the pit on the world map"},
    {"advance": 20},
    {"until": "$gameMap.mapId() === 19 && !$gamePlayer.isTransferring()", "frames": 600},
    {"frames": 60},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [12, 22, 8],
     "label": "on the floor at the foot of the rope, facing it"},
    {"check": "$gameMap.isEventRunning()", "expect": false, "label": "and not asked whether to leave"},
    {"check": "$gameMap.eventsXy(12, 21).map(e => e.isNormalPriority()).join()", "expect": "true",
     "label": "the rope's foot blocks"},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 30},
    {"check": "$gameMap._interpreter.eventId()", "expect": 1, "label": "walking into it is Up The Rope"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [12, 22], "label": "without climbing onto it"},
    {"frames": 120},
    {"choose": 1},
    {"frames": 60},
    {"check": "[$gameMap.mapId(), $gamePlayer.x, $gamePlayer.y, $gameMap.isEventRunning()]", "expect": [19, 12, 22, false],
     "label": "and 'No' stays at the bottom"},

    {"goto": [19, 19, 3]},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"key": "Enter"},
    {"frames": 30},
    {"check": "$gameMap._interpreter.eventId()", "expect": 8, "label": "the crack, from the floor below it"},
    {"advance": 10},

    {"eval": "$gameSwitches.setValue(27, true)", "comment": "a Guild member (SW_GUILD_MEMBER), or the Barrow will not let you in"},
    {"goto": [8, 68, 57]},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 30},
    {"advance": 20},
    {"until": "$gameMap.mapId() === 20 && !$gamePlayer.isTransferring()", "frames": 600},
    {"frames": 60},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [14, 24, 8],
     "label": "into the Barrow one north of Mike's mouth"},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"frames": 30},
    {"check": "$gameMap._interpreter.eventId()", "expect": 1, "label": "and the mouth is behind"},
    {"frames": 120},
    {"choose": 1},
    {"frames": 60},
    {"check": "$gameMap.isEventRunning()", "expect": false},

    {"goto": [20, 21, 13]},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"key": "Enter"},
    {"frames": 30},
    {"check": "$gameMap._interpreter.eventId()", "expect": 5, "label": "the hound's alcove, set back into the wall"},
    {"advance": 6},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [21, 13]},
    {"shot": "r12_hound.png"},

    {"comment": "The Gloamwood mimic, after: Dungeon_B's Scrap Wood, cut out as !$Splinters.",
     "eval": "$gameSelfSwitches.setValue([9, 5, 'A'], true)"},
    {"goto": [9, 12, 13]},
    {"check": "$gameMap.event(5).characterName()", "expect": "!$Splinters",
     "label": "the mimic is splinters now, and looks it"},
    {"frames": 30},
    {"shot": "r12_splinters.png"}
  ]
}
