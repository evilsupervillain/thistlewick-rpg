{
  "query": "?map=4&x=12&y=11&frames=90",
  "comment": "QUESTS.md A3, PIP-2 A Rhyme For Turnip. The gilded turnip without Piper is what it always was; with her before the road it is still that; after the road, her afternoon, put off once with 'Not now'. Then two parties, so every suggestion branch is taken exactly once: Piper with Hob and Wren (a trope each, Bram's parsnip, the payoff - four), SW_PIP2_DONE, SW_STORY[PIPER] and VAR_COMPANION_STORIES, the absent six asserted absent, and the page afterwards. Then the switch put back and the other six at the table - Merribell's blush, Roland's gracious fury - with the story counted once.",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"eval": "window._lines = []; const add = Game_Message.prototype.add; Game_Message.prototype.add = function (t) { window._lines.push(t); return add.call(this, t); }; window._mark = () => { window._tropes = $gameVariables.value(2); window._blushes = $gameVariables.value(7); window._lines = []; }; window._mark()"},
    {"check": "[$gameMap.mapId(), $gamePlayer.x, $gamePlayer.y]", "expect": [4, 12, 11]},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [12, 11, 8]},

    {"comment": "Without Piper, after the road: the turnip as it was.", "eval": "$gameSwitches.setValue(2, true); window._mark()"},
    {"check": "$gameMap.event(6).findProperPageIndex()", "expect": 0},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 6},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('It is not a metaphor.'))", "expect": true},
    {"check": "window._lines.some(l => /rhyme|Piper/.test(l))", "expect": false},

    {"comment": "Piper, but before the road: still the turnip as it was.", "eval": "$gameSwitches.setValue(2, false); $gameParty.addActor(7)"},
    {"frames": 20},
    {"check": "$gameMap.event(6).findProperPageIndex()", "expect": 0, "label": "not before the road"},

    {"comment": "After the road: the ask, put off.", "eval": "$gameSwitches.setValue(2, true); window._mark()"},
    {"frames": 20},
    {"check": "$gameMap.event(6).findProperPageIndex()", "expect": 1},
    {"key": "Enter"}, {"frames": 240},
    {"check": "$gameMap._interpreter.eventId()", "expect": 6},
    {"key": "Enter"}, {"frames": 240},
    {"key": "Enter"}, {"frames": 240},
    {"key": "Enter"}, {"frames": 240},
    {"check": "SceneManager._scene._messageWindow._choiceListWindow.active", "expect": true, "label": "the choice is up"},
    {"shot": "q_pip2_ask.png"},
    {"choose": 1},
    {"advance": 5},
    {"check": "window._lines.some(l => l.includes('It\\'s gold.'))", "expect": true, "label": "Not now"},
    {"check": "[$gameSwitches.value(114), $gameVariables.value(2) - window._tropes]", "expect": [false, 0]},

    {"comment": "Party one: Piper, Hob and Wren.", "eval": "$gameParty.addActor(3); $gameParty.addActor(9); window._mark()"},
    {"frames": 20},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 6},
    {"advance": 80},
    {"check": "window._lines.some(l => l.includes('Burnip.'))", "expect": true, "label": "Hob"},
    {"check": "window._lines.some(l => l.includes('Pre-emptively'))", "expect": true, "label": "Wren"},
    {"check": "window._lines.some(l => l.includes('parsnip'))", "expect": true, "label": "Bram"},
    {"check": "window._lines.some(l => /navet|TURNIP\\.|sherbet|pelvis|Drowned|Change/.test(l))", "expect": false, "label": "nobody who is not there"},
    {"check": "window._lines.some(l => l.includes('was worth the journey, and the wait.'))", "expect": true, "label": "the last verse"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 4, "label": "Hob, Wren, Bram and the payoff"},
    {"check": "$gameVariables.value(7) - window._blushes", "expect": 0},
    {"check": "[$gameSwitches.value(114), $gameSwitches.value(106), $gameVariables.value(15)]", "expect": [true, true, 1]},

    {"comment": "Afterwards.", "eval": "window._mark()"},
    {"check": "$gameMap.event(6).findProperPageIndex()", "expect": 2},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('Nine seconds.'))", "expect": true},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 0},

    {"comment": "Party two, the other six, with the switch put back to replay the afternoon.", "eval": "$gameSwitches.setValue(114, false); $gameParty.removeActor(3); $gameParty.removeActor(9); [2, 4, 5, 6, 8, 10].forEach(a => $gameParty.addActor(a)); window._mark()"},
    {"frames": 20},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 6},
    {"shot": "q_pip2_party.png"},
    {"advance": 120},
    {"check": "['navet', 'TURNIP.', 'sherbet', 'pelvis', 'Drowned', 'Change', 'parsnip', 'gracious'].map(w => window._lines.some(l => l.includes(w)))", "expect": [true, true, true, true, true, true, true, true], "label": "Aldric, Nix, Zephyrine, Merribell, Corvin, Roland, Bram, and Roland again"},
    {"check": "window._lines.some(l => /Burnip|Pre-emptively/.test(l))", "expect": false},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 8, "label": "six, Bram and the payoff"},
    {"check": "$gameVariables.value(7) - window._blushes", "expect": 1, "label": "Merribell's pelvis"},
    {"check": "[$gameSwitches.value(114), $gameVariables.value(15)]", "expect": [true, 1], "label": "the story counts once"},

    {"comment": "And without Piper, afterwards: the turnip as it was.", "eval": "$gameParty.removeActor(7); window._mark()"},
    {"frames": 20},
    {"check": "$gameMap.event(6).findProperPageIndex()", "expect": 0},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"}
  ]
}
