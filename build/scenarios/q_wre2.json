{
  "query": "?map=14&x=18&y=5&frames=90",
  "comment": "QUESTS.md A1, WRE-2 The Second Plaque. The goose without Wren is what it always was and the second plaque has no page; with her, the ask (a trope, once), the engraving card without her and with her, the wording settled and left with Mrs Barrow, too little money and then enough - paid without Wren, because the wording is left behind - the plate carried past the goose without her and nothing happens, then the handover with her: the plate spent, SW_WRE2_UP, SW_WREN_STORY and VAR_COMPANION_STORIES once. Then both plaques read, and the goose afterwards with and without her.",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"eval": "window._tropes = $gameVariables.value(2); window._lines = []; const add = Game_Message.prototype.add; Game_Message.prototype.add = function (t) { window._lines.push(t); return add.call(this, t); }"},
    {"check": "[$gameMap.mapId(), $gamePlayer.x, $gamePlayer.y]", "expect": [14, 18, 5]},
    {"check": "$gameMap.event(21).findProperPageIndex()", "expect": -1, "label": "the second plaque has no page until it is put up"},

    {"comment": "The goose, without Wren: its own two pages.", "key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "$gamePlayer.direction()", "expect": 8},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 14},
    {"advance": 20},
    {"check": "$gameSelfSwitches.value([14, 14, 'A'])", "expect": true},
    {"eval": "window._tropes = $gameVariables.value(2); window._lines = []"},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('Sixty years of everybody agreeing'))", "expect": true, "label": "page 2 as it was"},
    {"check": "window._lines.some(l => /retraction|brass|Brass/.test(l))", "expect": false, "label": "nothing of WRE-2 without Wren"},
    {"check": "[$gameSwitches.value(111), $gameSwitches.value(112), $gameSwitches.value(108), $gameVariables.value(15)]", "expect": [false, false, false, 0]},

    {"comment": "With Wren: the ask.", "eval": "$gameParty.addActor(9); window._lines = []"},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 14},
    {"shot": "q_wre2_ask.png"},
    {"advance": 40},
    {"check": "window._lines.some(l => l.includes('retraction'))", "expect": true},
    {"check": "window._lines.some(l => l.includes('Brass. Not paper.'))", "expect": true},
    {"check": "$gameSwitches.value(111)", "expect": true, "label": "SW_WRE2_ASKED"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1, "label": "the retcon is a trope"},
    {"eval": "window._lines = []"},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('By the letter'))", "expect": true, "label": "asked twice: the short version"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1, "label": "and it counts once"},

    {"comment": "Wick & Barrow's. The card in the basket, from the square below it, first without Wren.", "eval": "$gameParty.removeActor(9); $gameParty._gold = 100; window._lines = []"},
    {"goto": [16, 4, 7]},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [4, 7, 8]},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 5, "label": "the engraving card"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('Wren is not here'))", "expect": true},
    {"check": "[$gameParty.gold(), $gameSelfSwitches.value([16, 5, 'A'])]", "expect": [100, false], "label": "nothing settled without her"},

    {"comment": "With Wren, and a hundred crowns: the wording is settled and the money is short.", "eval": "$gameParty.addActor(9); window._lines = []"},
    {"key": "Enter"}, {"frames": 60},
    {"shot": "q_wre2_card.png"},
    {"advance": 40},
    {"check": "window._lines.some(l => l.includes('four hundred and'))", "expect": true},
    {"check": "window._lines.some(l => l.includes(\"It isn't about me.\"))", "expect": true},
    {"check": "[$gameParty.gold(), $gameParty.numItems($dataItems[40]), $gameSelfSwitches.value([16, 5, 'A'])]", "expect": [100, 0, true], "label": "short of 128: nothing bought, and the wording left with Mrs Barrow"},

    {"comment": "Enough money, and Wren sent home: the wording is pinned up, so anybody can pay.", "eval": "$gameParty.removeActor(9); $gameParty.gainGold(100); window._lines = []"},
    {"key": "Enter"}, {"frames": 60}, {"advance": 20},
    {"check": "window._lines.some(l => l.includes('pinned up'))", "expect": true},
    {"check": "[$gameParty.gold(), $gameParty.numItems($dataItems[40])]", "expect": [72, 1], "label": "128 crowns for 128 letters, and the plate"},
    {"eval": "window._lines = []"},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('Mind the edges'))", "expect": true, "label": "the card while the plate is carried"},

    {"comment": "Back to the goose with the plate and without Wren: the goose's own page, and the plate is still held.", "eval": "window._lines = []"},
    {"goto": [14, 18, 5]},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('Sixty years of everybody agreeing'))", "expect": true},
    {"check": "[$gameParty.numItems($dataItems[40]), $gameSwitches.value(112)]", "expect": [1, false], "label": "the quest giver keeps the quest"},

    {"comment": "With her: the handover.", "eval": "$gameParty.addActor(9); window._lines = []"},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 14},
    {"advance": 40},
    {"check": "window._lines.some(l => l.includes('Decided.'))", "expect": true, "label": "readmission is a line"},
    {"check": "[$gameParty.numItems($dataItems[40]), $gameSwitches.value(111), $gameSwitches.value(112)]", "expect": [0, false, true], "label": "the plate is up"},
    {"check": "[$gameSwitches.value(108), $gameVariables.value(15)]", "expect": [true, 1], "label": "SW_WREN_STORY, and one companion with a story"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1, "label": "no second trope"},
    {"eval": "window._lines = []"},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('Two days, with wire.'))", "expect": true, "label": "the goose afterwards, with her"},
    {"check": "$gameVariables.value(15)", "expect": 1},

    {"comment": "The second plaque, on the right of the fire.", "eval": "window._lines = []"},
    {"key": "ArrowRight", "times": 1, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [19, 5, 8]},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 21},
    {"frames": 150},
    {"shot": "q_wre2_plaque.png"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('BECAUSE THE VILLAGE WAS WAITING ON THE QUAY.'))", "expect": true},
    {"check": "window._lines.some(l => l.includes('polished this one too'))", "expect": true},

    {"comment": "And the first, on the left, unchanged.", "eval": "window._lines = []"},
    {"key": "ArrowLeft", "times": 2, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [17, 5, 8]},
    {"key": "Enter"}, {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 18},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('SLAIN BY H. VANCE'))", "expect": true, "label": "both plaques stay up"},

    {"comment": "Wren sent home: the goose is its own page 2 again, and the second plaque is still there for everybody.", "eval": "$gameParty.removeActor(9); window._lines = []"},
    {"key": "ArrowRight", "times": 1, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"key": "Enter"}, {"frames": 60}, {"advance": 10},
    {"check": "window._lines.some(l => l.includes('Sixty years of everybody agreeing'))", "expect": true},
    {"check": "$gameMap.event(21).findProperPageIndex()", "expect": 0},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"}
  ]
}
