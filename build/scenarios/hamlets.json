{
  "query": "?map=8&x=97&y=102&frames=90",
  "comment": "SITES.md step 13, walked: onto Little Gore's door off the world map from the grass south of it, in, the three Vanes playing weddings on the green, Mrs Vane twice, Dame Winifred Cope (the Order's white pin at Little Gore), the banns - with INVITATIONS TO FOLLOW under them - the fingerpost, and back out onto places.LITTLE_GORE_STEP; then onto Sump's door, in, the sign (the cursed village, a trope, counted once), the well and its wasps, the pool that is the sea, Mr Gammage twice, the Parish Clerk, the Parish Clerk with Merribell in the party (the reaction shot, not MER-5, and no diagnosis in it), the minutes, Mrs Pardew, and back out onto places.SUMP_STEP. Walked rather than started by hand, because each door is a placeholder replaced and only arriving proves the swap landed on the right square; every event is reached with the action button from the square a player would stand on, checked by $gameMap._interpreter.eventId().",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"eval": "window._tropes = $gameVariables.value(2); window._blushes = $gameVariables.value(7); window._lines = []; const add = Game_Message.prototype.add; Game_Message.prototype.add = function (t) { window._lines.push(t); return add.call(this, t); }"},
    {"check": "$gameMap.mapId()", "expect": 8},
    {"check": "$dataMap.events.filter(e => e && (e.name === 'Little Gore' || e.name === 'Sump')).map(e => [e.name, e.x, e.y, e.pages[0].trigger, e.pages[0].priorityType, (e.note||'').includes('-site')])",
     "expect": [["Little Gore", 97, 101, 1, 0, false], ["Sump", 78, 102, 1, 0, false]],
     "label": "one real door on each stamp's one cell: player-touch, below characters, and neither of them a placeholder any more"},
    {"check": "$gameParty.members().some(a => a.actorId() === 2)", "expect": false,
     "label": "Merribell is not in the party to begin with"},

    {"comment": "One north onto Little Gore's door.",
     "key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [97, 101],
     "label": "standing on Little Gore's door"},
    {"check": "$gameMap._interpreter.isRunning()", "expect": true,
     "label": "THE POINT: this door does something now"},
    {"shot": "hamlets_gore_door.png"},
    {"advance": 6},
    {"frames": 120},
    {"check": "$gameMap.mapId()", "expect": 50, "label": "in Little Gore"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [11, 16],
     "label": "at the bottom of the road in"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"comment": "Up the road to the street, along it, and down onto the green above Alfie.",
     "key": "ArrowUp", "times": 4, "gap": 30},
    {"key": "ArrowLeft", "times": 5, "gap": 30},
    {"key": "ArrowDown", "times": 2, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [6, 13, 2],
     "label": "above Alfie, facing him"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 6, "label": "Alfie, who is the groom"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes(\"that's the\"))", "expect": true},

    {"comment": "Two west, above Bess.",
     "key": "ArrowLeft", "times": 2, "gap": 30},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [4, 13, 2],
     "label": "above Bess, facing her"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 5, "label": "Bess, who is the bride"},
    {"advance": 10},

    {"comment": "Between the bride and the groom, above Nell.",
     "key": "ArrowRight", "times": 1, "gap": 30},
    {"key": "ArrowDown", "times": 2, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [5, 14, 2],
     "label": "above Nell, facing her"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 7, "label": "Nell, who is everybody else"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('the rain and the cake'))", "expect": true},
    {"shot": "hamlets_green.png"},

    {"comment": "Back up to the street, and up to Mrs Vane in her front garden.",
     "key": "ArrowUp", "times": 2, "gap": 30},
    {"key": "ArrowRight", "times": 3, "gap": 30},
    {"key": "ArrowUp", "times": 2, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [8, 11, 8],
     "label": "below Mrs Vane, facing her"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 3, "label": "Hester Vane"},
    {"shot": "hamlets_vane.png"},
    {"advance": 40},
    {"check": "$gameSelfSwitches.value([50, 3, 'A'])", "expect": true},
    {"check": "window._lines.some(l => l.includes('nine years ago this summer'))", "expect": true,
     "label": "married nine years ago, at Fenmarch, and all Little Gore walked over"},
    {"check": "window._lines.some(l => /letter|mantel|Aldric/i.test(l))", "expect": false,
     "label": "and nothing of ALD-1 spent: no letter, no mantelpiece, no Aldric"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 3},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes(\"in the gardens at Fenmarch\"))", "expect": true,
     "label": "the second page"},

    {"comment": "Along the street to Dame Winifred, by her own door.",
     "key": "ArrowRight", "times": 8, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [16, 11, 8],
     "label": "below Dame Winifred, facing her"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 4, "label": "Dame Winifred Cope"},
    {"advance": 20},
    {"check": "window._lines.some(l => l.includes('in me at Coldbarrow'))", "expect": true,
     "label": "Coldbarrow's white pin at Little Gore, standing exactly where it says"},

    {"comment": "Down onto the green, above the notice board.",
     "key": "ArrowDown", "times": 2, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [16, 12, 2],
     "label": "above the banns, facing them"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 8, "label": "the banns"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('INVITATIONS TO FOLLOW'))", "expect": true,
     "label": "ALD-1's set-up, and none of its payoff"},
    {"shot": "hamlets_banns.png"},

    {"comment": "West along the street, and down the east side of the road to the fingerpost.",
     "key": "ArrowLeft", "times": 3, "gap": 30},
    {"key": "ArrowDown", "times": 3, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [13, 14, 2],
     "label": "above the fingerpost, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 9, "label": "the fingerpost"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('FENMARCH  4 MILES'))", "expect": true},

    {"comment": "And out, down the road.",
     "key": "ArrowLeft", "times": 1, "gap": 30},
    {"key": "ArrowDown", "times": 3, "gap": 30},
    {"frames": 150},
    {"check": "$gameMap.mapId()", "expect": 8, "label": "back on the world map"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [97, 102],
     "label": "on places.LITTLE_GORE_STEP, one south of the door"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 0,
     "label": "Little Gore is no cliche"},
    {"check": "$gameVariables.value(7) - window._blushes", "expect": 0,
     "label": "and no blush: it is warm, not red"},

    {"comment": "Sump. One north onto its door from the only square of sand beside it.",
     "goto": [8, 78, 103]},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [78, 102],
     "label": "standing on Sump's door"},
    {"check": "$gameMap._interpreter.isRunning()", "expect": true},
    {"shot": "hamlets_sump_door.png"},
    {"advance": 6},
    {"frames": 120},
    {"check": "$gameMap.mapId()", "expect": 51, "label": "in Sump"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [10, 14],
     "label": "at the bottom of the street"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"comment": "The fingerpost beside the road in.",
     "key": "ArrowRight", "times": 2, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [11, 14, 6],
     "label": "beside the sign, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 8, "label": "the sign"},
    {"advance": 10},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1,
     "label": "the cursed village and its ancient affliction is a trope"},

    {"comment": "Up one and along to the well.",
     "key": "ArrowUp", "times": 1, "gap": 30},
    {"key": "ArrowRight", "times": 3, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [13, 13, 6],
     "label": "beside the well, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 6, "label": "the well"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('goes back down to report'))", "expect": true,
     "label": "the wasps, heard and not drawn"},
    {"shot": "hamlets_well.png"},

    {"comment": "Up one and west along the row above the pool.",
     "key": "ArrowUp", "times": 1, "gap": 30},
    {"key": "ArrowLeft", "times": 7, "gap": 30},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [6, 12, 2],
     "label": "above the pool, facing it"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 9, "label": "the pool"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('It is salt'))", "expect": true,
     "label": "the stamp's oasis is the sea"},

    {"comment": "Up to the street, and Mr Gammage against the wall.",
     "key": "ArrowUp", "times": 2, "gap": 30},
    {"key": "ArrowRight", "times": 1, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [7, 10, 8],
     "label": "below Mr Gammage, facing him"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 4, "label": "Mr Gammage"},
    {"advance": 20},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 4},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('would like you'))", "expect": true,
     "label": "the second page"},

    {"comment": "Along the street to the parish hut, and the Clerk.",
     "key": "ArrowRight", "times": 5, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [12, 10, 8],
     "label": "below Mr Thurle, facing him"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 3, "label": "Absalom Thurle, Parish Clerk"},
    {"shot": "hamlets_thurle.png"},
    {"advance": 40},
    {"check": "$gameSelfSwitches.value([51, 3, 'A'])", "expect": true},
    {"check": "window._lines.some(l => l.includes(\"there wasn't any\"))", "expect": true,
     "label": "the Water Committee, wound up in 1794 for want of water"},
    {"check": "window._lines.some(l => l.includes('Through the chair'))", "expect": false,
     "label": "without Merribell, no Merribell"},

    {"comment": "The branch: Merribell in the party, and the first page again.",
     "eval": "$gameParty.addActor(2); $gameSelfSwitches.setValue([51, 3, 'A'], false); window._lines = []"},
    {"frames": 10},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 3},
    {"advance": 50},
    {"check": "window._lines.some(l => l.includes('nine seconds')) && window._lines.some(l => l.includes('Through the chair'))", "expect": true,
     "label": "with Merribell: the reaction shot"},
    {"check": "window._lines.some(l => /dehydrat|thirst|drink|a glass of/i.test(l))", "expect": false,
     "label": "and nothing of MER-5 spent: nobody says what the curse is"},
    {"eval": "$gameParty.removeActor(2)"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1,
     "label": "the Clerk counts no trope of his own"},

    {"comment": "The minutes, pinned up beside him.",
     "key": "ArrowRight", "times": 1, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [13, 10, 8],
     "label": "below the minutes, facing them"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 7, "label": "the minutes"},
    {"advance": 10},
    {"check": "window._lines.some(l => l.includes('WASPS - DEFERRED'))", "expect": true},

    {"comment": "Mrs Pardew, at the east end.",
     "key": "ArrowRight", "times": 4, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [17, 10, 8],
     "label": "below Mrs Pardew, facing her"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 5, "label": "Mrs Pardew"},
    {"advance": 20},

    {"comment": "And out, down the street.",
     "key": "ArrowLeft", "times": 6, "gap": 30},
    {"key": "ArrowDown", "times": 5, "gap": 30},
    {"frames": 150},
    {"check": "$gameMap.mapId()", "expect": 8, "label": "back on the world map"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [78, 103],
     "label": "on places.SUMP_STEP, one south of the door"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1},
    {"check": "$gameVariables.value(7) - window._blushes", "expect": 0,
     "label": "and no blush in either hamlet"},
    {"shot": "hamlets_out.png"}
  ]
}
