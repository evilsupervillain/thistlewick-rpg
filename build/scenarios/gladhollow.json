{
  "query": "?map=8&x=33&y=112&frames=90",
  "comment": "SITES.md step 5: Gladhollow and the mayor's room, one site on two Village B cells. Walked the whole way, not started by hand: onto the western door cell off the world map and in at the west gate, into Toby three times - walking into him, then two of the fourteen, with VAR_TOBY (14) asserted to move each time - along the road to the mayor's house, through the bookcase to the ledger, back up the steps and out, Toby's one line he is not allowed, a barrel of Granny Wendle's and a potion given back to her, and out through the west gate onto places.GLADHOLLOW_STEP.",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"eval": "window._tropes = $gameVariables.value(2); window._potions = $gameParty.numItems($dataItems[1])"},
    {"check": "$gameMap.mapId()", "expect": 8},
    {"check": "$dataMap.events.filter(e => e && e.name === 'Gladhollow').map(e => [e.name, e.x, e.y])",
     "expect": [["Gladhollow", 33, 111], ["Gladhollow", 34, 111]],
     "label": "two door events: Village B is two cells"},
    {"check": "$dataMap.events.filter(e => e && e.name === 'Gladhollow').every(e => !(e.note||'').includes('-site'))",
     "expect": true,
     "label": "and neither is a placeholder any more"},

    {"comment": "One north onto the western door cell. Player-touch, below characters.",
     "key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [33, 111],
     "label": "standing on Gladhollow's western door"},
    {"check": "$gameMap._interpreter.isRunning()", "expect": true,
     "label": "THE POINT: this door does something now"},
    {"advance": 6},
    {"frames": 150},
    {"check": "$gameMap.mapId()", "expect": 40, "label": "in at the west gate"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [1, 10]},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},
    {"shot": "gladhollow_gate.png"},

    {"comment": "One step east, and Toby is in the way, as he is about forty times a day.",
     "key": "ArrowRight", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [2, 10, 6],
     "label": "face to face with Toby"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 1, "label": "walking into Toby"},
    {"shot": "gladhollow_toby.png"},
    {"advance": 20},
    {"check": "$gameVariables.value(14)", "expect": 1, "label": "number one, the Standard"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1,
     "label": "the villager who says 'Welcome to Gladhollow!' is a trope"},
    {"check": "$gameSelfSwitches.value([40, 1, 'A'])", "expect": true},

    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 1},
    {"advance": 30},
    {"check": "$gameVariables.value(14)", "expect": 2, "label": "THE POINT: number two, the Formal - the variable moves"},
    {"key": "Enter"},
    {"frames": 60},
    {"advance": 30},
    {"check": "$gameVariables.value(14)", "expect": 3, "label": "and number three, the Whisper"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 1,
     "label": "the fourteen bump nothing; only the first meeting is a trope"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"comment": "Round him on the lower lane and along the road to the mayor's door at (16,8).",
     "key": "ArrowDown", "times": 1, "gap": 30},
    {"key": "ArrowRight", "times": 14, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [16, 11]},
    {"key": "ArrowUp", "times": 2, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [16, 9], "label": "on the mayor's step"},
    {"shot": "gladhollow_mayor_front.png"},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 150},
    {"check": "$gameMap.mapId()", "expect": 41, "label": "inside the mayor's house"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [7, 8]},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"comment": "Up past the desk to the bookcase at (9,4), which is faced from (9,5).",
     "key": "ArrowUp", "times": 3, "gap": 30},
    {"key": "ArrowRight", "times": 2, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [9, 5, 8],
     "label": "in front of the bookcase, facing it"},
    {"shot": "gladhollow_office.png"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 2, "label": "the bookcase"},
    {"advance": 10},
    {"frames": 120},
    {"check": "[$gameMap.mapId(), $gamePlayer.x, $gamePlayer.y]", "expect": [41, 21, 6],
     "label": "through the bookcase and down the steps"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 2,
     "label": "the passage behind the bookcase is the second trope"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"comment": "The ledger, on the table at (17,4), round the pier beside the steps.",
     "key": "ArrowLeft", "times": 2, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"key": "ArrowLeft", "times": 2, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [17, 5, 8]},
    {"shot": "gladhollow_back_room.png"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 4, "label": "the ledger: DO NOT TELL TOBY"},
    {"advance": 20},
    {"check": "$gameSelfSwitches.value([41, 4, 'A'])", "expect": true, "label": "read, which is what Toby is waiting for"},

    {"comment": "Back up the steps at (21,4-5), out through the office and the door.",
     "key": "ArrowRight", "times": 2, "gap": 30},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"key": "ArrowRight", "times": 2, "gap": 30},
    {"key": "ArrowUp", "times": 2, "gap": 30},
    {"frames": 120},
    {"check": "[$gameMap.mapId(), $gamePlayer.x, $gamePlayer.y]", "expect": [41, 9, 5],
     "label": "up the steps, in front of the bookcase"},
    {"key": "ArrowDown", "times": 3, "gap": 30},
    {"key": "ArrowLeft", "times": 2, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [7, 8]},
    {"key": "ArrowDown", "times": 2, "gap": 30},
    {"frames": 120},
    {"check": "[$gameMap.mapId(), $gamePlayer.x, $gamePlayer.y]", "expect": [40, 16, 9],
     "label": "back on the mayor's step"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"comment": "Back to Toby, from below this time: he is at (3,10).",
     "key": "ArrowDown", "times": 2, "gap": 30},
    {"key": "ArrowLeft", "times": 13, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [3, 11, 8],
     "label": "under Toby, facing him"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 1},
    {"shot": "gladhollow_back.png"},
    {"advance": 20},
    {"check": "$gameSelfSwitches.value([40, 1, 'B'])", "expect": true,
     "label": "Welcome BACK to Glad- I'm not allowed that one"},
    {"check": "$gameVariables.value(14)", "expect": 3, "label": "and it was not one of the fourteen"},
    {"key": "Enter"},
    {"frames": 60},
    {"advance": 30},
    {"check": "$gameVariables.value(14)", "expect": 4, "label": "after which he is back on the list: number four"},

    {"comment": "A barrel of Granny Wendle's at (4,9), faced from (4,10).",
     "key": "ArrowRight", "times": 1, "gap": 30},
    {"key": "ArrowUp", "times": 2, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [4, 10, 8]},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 12},
    {"advance": 20},
    {"check": "$gameParty.numItems($dataItems[1]) - window._potions", "expect": 1,
     "label": "a Potion, in a stocking, with a label on it"},

    {"comment": "And Granny Wendle, at (6,9), who would like it back.",
     "key": "ArrowRight", "times": 2, "gap": 30},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"check": "[$gamePlayer.x, $gamePlayer.y, $gamePlayer.direction()]", "expect": [6, 10, 8]},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 10},
    {"shot": "gladhollow_granny.png"},
    {"advance": 30},
    {"check": "$gameParty.numItems($dataItems[1]) - window._potions", "expect": 0,
     "label": "given back: that's Tuesday's knee sorted"},
    {"check": "$gameVariables.value(2) - window._tropes", "expect": 3,
     "label": "the hero who helps himself to a stranger's barrels is the third trope"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"comment": "Out through the west gate, on the lower lane, round Toby.",
     "key": "ArrowDown", "times": 1, "gap": 30},
    {"key": "ArrowLeft", "times": 6, "gap": 30},
    {"frames": 120},
    {"check": "$gameMap.mapId()", "expect": 8, "label": "back on the world map"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [33, 112],
     "label": "on places.GLADHOLLOW_STEP, one south of the western door"}
  ]
}
