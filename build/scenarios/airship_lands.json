{
  "query": "?map=8&x=45&y=49&frames=90",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"eval": "$gameSwitches.setValue(53, true)"},
    {"eval": "$gameMap.airship().setLocation(8, 45, 48)"},
    {"frames": 30},

    {"check": "$gameMap.isAirshipLandOk(66, 43)", "expect": false,
     "label": "CLAUSE SEVEN: the engine refuses to set her down on the tower door"},
    {"check": "$gameMap.isAirshipLandOk(65, 43)", "expect": true,
     "label": "and will put her on the grass beside it"},
    {"check": "$gameMap.isAirshipLandOk(57, 83)", "expect": true,
     "label": "the Isle of Uncertain Ownership can be landed on"},
    {"check": "$gameMap.isAirshipLandOk(57, 82)", "expect": false,
     "label": "and the sea round it cannot"},
    {"check": "$gameMap.isAirshipLandOk(39, 40)", "expect": true,
     "label": "so can Attempt 112's sea stack"},
    {"check": "$gameMap.isAirshipLandOk(37, 40)", "expect": false,
     "label": "though not the rock she came down on"},
    {"check": "$gameMap.isAirshipLandOk(83, 66)", "expect": true,
     "label": "and the Hermit's middle distance"},
    {"check": "$gameMap.isAirshipLandOk(82, 65)", "expect": false,
     "label": "though not the hill on top of it"},

    {"key": "ArrowUp", "times": 1},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [45, 48],
     "label": "you can walk onto an airship; it is above you, not in the way"},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gamePlayer.isInAirship()", "expect": true,
     "label": "and the action button takes her up"},
    {"shot": "airship_flight.png"},

    {"eval": "$gamePlayer.locate(66, 43)"},
    {"frames": 60},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gamePlayer.isInAirship()", "expect": true,
     "label": "THE JOKE: over the tower door, the button does nothing at all"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [66, 43],
     "label": "she is directly above the step and she is not coming down on it"},

    {"eval": "$gamePlayer.locate(65, 43)"},
    {"frames": 60},
    {"key": "Enter"},
    {"frames": 90},
    {"check": "$gamePlayer.isInAirship()", "expect": false,
     "label": "one square to the west, on the grass, she lands"},
    {"advance": 20},
    {"check": "$gameSwitches.value(68)", "expect": true,
     "label": "and the last two squares to the Obligatory Tower are walked"},
    {"key": "ArrowUp", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [65, 42],
     "label": "step off her - a parked airship is drawn below characters"},
    {"shot": "airship_tower.png"},
    {"key": "ArrowDown", "times": 1, "gap": 30},

    {"key": "ArrowRight", "times": 1},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 4,
     "label": "walking east off the grass reaches the tower door on foot"},
    {"choose": 1},
    {"advance": 8},
    {"check": "$gameMap.mapId()", "expect": 8,
     "label": "'Not yet' leaves you standing outside it"},

    {"eval": "$gamePlayer.locate(65, 43)"},
    {"frames": 30},
    {"key": "Enter"},
    {"frames": 90},
    {"check": "$gamePlayer.isInAirship()", "expect": true,
     "label": "back aboard"},
    {"eval": "$gamePlayer.locate(57, 82)"},
    {"frames": 60},
    {"key": "Enter"},
    {"frames": 60},
    {"check": "$gamePlayer.isInAirship()", "expect": true,
     "label": "out over open water, one square short, she will not come down either"},
    {"eval": "$gamePlayer.locate(57, 83)"},
    {"frames": 60},
    {"key": "Enter"},
    {"frames": 120},
    {"check": "$gamePlayer.isInAirship()", "expect": false,
     "label": "and one square further south there is a rock, and she lands on it"},
    {"shot": "airship_isle.png"},

    {"key": "ArrowUp", "times": 2, "gap": 24},
    {"key": "ArrowDown", "times": 2, "gap": 24},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [57, 83],
     "label": "north and south of the pad is open water, and it is not walkable"},

    {"key": "ArrowRight", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 21,
     "label": "the sheep, which has done extremely well out of two hundred years of this"},
    {"advance": 20},
    {"key": "ArrowLeft", "times": 2, "gap": 30},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 20,
     "label": "and the plaque, which has never finished its own sentence"},
    {"advance": 20},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [56, 83],
     "label": "four squares of island, and that is the whole parish"},

    {"key": "ArrowRight", "times": 1, "gap": 30},
    {"frames": 60},
    {"key": "Enter"},
    {"frames": 120},
    {"check": "$gamePlayer.isInAirship()", "expect": true,
     "label": "and off it again the only way there is"},
    {"eval": "$gamePlayer.locate(39, 40)"},
    {"frames": 60},
    {"key": "Enter"},
    {"frames": 120},
    {"check": "$gamePlayer.isInAirship()", "expect": false,
     "label": "Attempt 112, on a rock, where nobody has ever been able to get"},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [39, 40]},
    {"key": "ArrowLeft", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 22,
     "label": "the wreck is one square west, and walking into her is the event"},
    {"advance": 40},
    {"check": "$gameParty.numItems($dataItems[31])", "expect": 1,
     "label": "and the number-plate comes off in one turn of a spanner"},

    {"key": "ArrowRight", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [39, 40]},
    {"shot": "airship_stack.png"},
    {"key": "Enter"},
    {"frames": 120},
    {"check": "$gamePlayer.isInAirship()", "expect": true},
    {"eval": "$gamePlayer.locate(83, 66)"},
    {"frames": 60},
    {"key": "Enter"},
    {"frames": 120},
    {"check": "$gamePlayer.isInAirship()", "expect": false,
     "label": "the thing the Hermit has been looking at for nineteen years"},
    {"key": "ArrowDown", "times": 1, "gap": 30},
    {"key": "ArrowLeft", "times": 1, "gap": 30},
    {"frames": 60},
    {"check": "$gameMap._interpreter.eventId()", "expect": 23,
     "label": "there is a bench on it, and it is nobody's, and it has no plaque"},
    {"advance": 40},
    {"check": "$gameMap._interpreter.isRunning()", "expect": false,
     "label": "you sit on it. Nothing happens. That is the entire event"},
    {"shot": "airship_middle_distance.png"}
  ]
}
