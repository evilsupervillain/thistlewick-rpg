    {"check": "$gameVariables.value(2)", "expect": 1, "label": "still one rummage"},
    {"goto": [17, 3, 10]},
    {"eval": "$gameMap.event(405).start()"},
    {"frames": 240},
    {"key": "Enter"},
    {"frames": 240},
    {"key": "Enter"},
    {"until": "$gameMessage.allText().includes('the garden')", "frames": 1200},
    {"check": "$gameMessage.faceName() !== ''", "expect": true, "label": "Mr Quy answers with his face"},
    {"advance": 10},
    {"check": "$gameVariables.value(2)", "expect": 2, "label": "the wardrobe-to-another-world is its own cliche"},
