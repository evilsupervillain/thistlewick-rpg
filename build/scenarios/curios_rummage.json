    {"eval": "$gameSystem.disableEncounter(); $gameVariables.setValue(2, 0)"},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},
    {"key": "ArrowUp"},
    {"frames": 20},
    {"check": "$gamePlayer.direction()", "expect": 8, "label": "facing Pell's drawers"},
    {"key": "Enter"},
