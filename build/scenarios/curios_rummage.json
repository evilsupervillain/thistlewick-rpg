    {"goto": [36, 9, 5]},
    {"eval": "$gameMap.event(401).start()"},
    {"frames": 240},
    {"key": "Enter"},
    {"frames": 240},
    {"key": "Enter"},
    {"until": "$gameMessage.allText().includes('Usually it')", "frames": 1200},
