    {"goto": [69, 29, 5]},
    {"key": "ArrowUp"},
    {"frames": 20},
    {"check": "$gamePlayer.y", "expect": 5, "label": "the swords' wall stops you"},
    {"key": "Enter"},
    {"until": "$gameMessage.allText().includes('Two swords crossed')", "frames": 1200},
    {"advance": 10},
    {"check": "$gameVariables.value(2)", "expect": 3, "label": "Mr Gotobed's swords: retired_hero is its own cliche"},
    {"key": "ArrowRight", "gap": 30},
    {"key": "ArrowUp"},
    {"frames": 20},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [30, 5], "label": "in front of the drawers"},
    {"key": "Enter"},
    {"until": "$gameMessage.allText().includes('every road Mr Gotobed')", "frames": 1200},
    {"advance": 10},
    {"check": "$gameMap.isEventRunning()", "expect": false, "label": "FOUND IT, and it finished"}
