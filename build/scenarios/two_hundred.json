{
  "query": "?map=22&x=12&y=16&frames=90",
  "steps": [
    {"eval": "$gameSystem.disableEncounter()"},
    {"check": "$gameSwitches.value(48)", "expect": false,
     "label": "nobody has asked for anything yet"},
    {"check": "$gameMap.airship()._mapId", "expect": 0,
     "label": "and the Two Hundred is on map 0, which is nowhere"},

    {"key": "ArrowUp", "times": 5},
    {"check": "[$gamePlayer.x, $gamePlayer.y]", "expect": [12, 11],
     "label": "the gap amidships is walkable, and walking into it says something"},
    {"advance": 12},
    {"check": "$gameSwitches.value(48)", "expect": false,
     "label": "but standing in her airship before she has finished asks for nothing"},

    {"eval": "$gameMap.event(2).start()"},
    {"advance": 40},
    {"eval": "$gameMap.event(2).start()"},
    {"advance": 40},
    {"eval": "$gameMap.event(2).start()"},
    {"advance": 40},
    {"eval": "$gameMap.event(2).start()"},
    {"advance": 40},
    {"check": "$gameSelfSwitches.value([22, 2, 'D'])", "expect": true,
     "label": "four conversations, and the steam ladder is finished"},
    {"check": "$gameVariables.value(7)", "expect": 4,
     "label": "four blushes out of it, exactly as clanging_cast says"},

    {"key": "ArrowDown", "times": 1},
    {"key": "ArrowUp", "times": 1},
    {"advance": 5},
    {"frames": 60},
    {"shot": "two_hundred_ask.png"},
    {"advance": 40},
    {"check": "$gameSwitches.value(48)", "expect": true,
     "label": "now amidships gets you the ask - and the third thing is you"},
    {"check": "$gameSwitches.value(49)", "expect": true,
     "label": "forty bolts of oilskin are wanted"},
    {"check": "$gameSwitches.value(51)", "expect": true,
     "label": "and a main spar that will not fracture"},

    {"goto": [24, 9, 11]},
    {"eval": "$gameMap.event(2).start()"},
    {"advance": 40},
    {"check": "$gameSwitches.value(52)", "expect": false,
     "label": "on his own it is a day's work and not an afternoon's"},
    {"check": "$gameSelfSwitches.value([24, 2, 'C'])", "expect": true,
     "label": "but it is started"},
    {"eval": "$gameMap.event(2).start()"},
    {"advance": 40},
    {"check": "$gameSwitches.value(52)", "expect": true,
     "label": "and the next time you ask, the spar is up on the wall"},
    {"check": "$gameSwitches.value(58)", "expect": false,
     "label": "and nobody has gone for a drink, because Grumnir is four days south"},

    {"goto": [16, 8, 10]},
    {"eval": "$gameMap.event(2).start()"},
    {"frames": 90},
    {"shot": "two_hundred_barrow.png"},
    {"advance": 40},
    {"check": "$gameParty.numItems($dataItems[30])", "expect": 1,
     "label": "forty bolts of oilskin, on account, at Wick and Barrow"},

    {"eval": "$gameMap.event(2).start()"},
    {"frames": 60},
    {"key": "Enter"},
    {"frames": 90},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Shop",
     "label": "and from the next word onwards she is the shopkeeper she always was"},
    {"key": "Escape"},
    {"frames": 90},
    {"check": "SceneManager._scene.constructor.name", "expect": "Scene_Map"},

    {"goto": [22, 12, 16]},
    {"eval": "$gameMap.event(2).start()"},
    {"advance": 40},
    {"check": "$gameSwitches.value(50)", "expect": true,
     "label": "Ott counts all forty of them, out loud, and takes them"},
    {"check": "$gameParty.numItems($dataItems[30])", "expect": 0},

    {"eval": "$gameMap.event(2).start()"},
    {"advance": 4},
    {"frames": 60},
    {"shot": "two_hundred_handover.png"},
    {"advance": 60},
    {"check": "$gameSwitches.value(53)", "expect": true,
     "label": "both parts in, and the Two Hundred is handed over"},
    {"check": "$gameMap.airship()._mapId", "expect": 8,
     "label": "the vehicle is placed on the world map"},
    {"check": "[$gameMap.airship()._x, $gameMap.airship()._y]", "expect": [10, 13],
     "label": "on the grass outside the town gate"},
    {"check": "$gameSwitches.value(68)", "expect": false,
     "label": "and she has not reached the tower, so the log still stops at 199"},

    {"eval": "$gameMap.event(5).start()"},
    {"advance": 40},
    {"eval": "$gameSwitches.setValue(68, true)"},
    {"frames": 30},
    {"eval": "$gameMap.event(5).start()"},
    {"advance": 40},
    {"check": "$gameMap.event(5).findProperPageIndex()", "expect": 1,
     "label": "and once she has, the attempt log has one more line in it"},

    {"goto": [8, 9, 14]},
    {"frames": 60},
    {"shot": "two_hundred_parked.png"}
  ]
}
