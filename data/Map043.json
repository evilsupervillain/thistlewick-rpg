{"id":2,"name":"Tobias Frayne","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People3","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Visitors! Come in, come in."]},{"code":401,"indent":0,"parameters":["Mind the ladder. Well - don't mind it."]},{"code":401,"indent":0,"parameters":["Stand wherever you like."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask what is wrong with the ladder."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Third rung. Goes like a biscuit."]},{"code":401,"indent":0,"parameters":["Thirty years I've meant to mend it,"]},{"code":401,"indent":0,"parameters":["and it's never quite been the moment."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask how many times it has gone."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] The ladder? Four. The well's two,"]},{"code":401,"indent":0,"parameters":["the bull's two, the cliff's one, and"]},{"code":401,"indent":0,"parameters":["two I'd sooner not go into, because"]},{"code":401,"indent":0,"parameters":["I was in a hurry and it was silly."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You add them up, and ask whether he means"]},{"code":401,"indent":0,"parameters":["he has died eleven times."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Oh, nobody DIES on the coast road."]},{"code":401,"indent":0,"parameters":["Somebody always comes by. Adventurers."]},{"code":401,"indent":0,"parameters":["They're going that way anyway, they say."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] And they're ever so kind about it."]},{"code":401,"indent":0,"parameters":["Kneel down. Hold your hand."]},{"code":401,"indent":0,"parameters":["Ask your name. Ask it twice, sometimes."]},{"code":401,"indent":0,"parameters":["You don't get that from the parish."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He glances at the ladder. Then at you."]},{"code":401,"indent":0,"parameters":["Then, quite fondly, at the ladder."]},{"code":122,"indent":0,"parameters":[2,2,1,0,1]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People3","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Staying for tea? I might just pop up"]},{"code":401,"indent":0,"parameters":["the ladder while the kettle's on."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He does not go up the ladder. He only"]},{"code":401,"indent":0,"parameters":["wants you to know that he could."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":2,"actorValid":true,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People3","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Visitors! And a Sister, look."]},{"code":401,"indent":0,"parameters":["I'll just pop up the ladder, shall I,"]},{"code":401,"indent":0,"parameters":["while the kettle's on?"]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] You will not."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She has his wrist before he has reached the ladder,"]},{"code":401,"indent":0,"parameters":["and is counting."]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] Pulse, good. Colour, good."]},{"code":401,"indent":0,"parameters":["Collarbone, set four times."]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] Wrist, set twice, by a paladin."]},{"code":401,"indent":0,"parameters":["Beautifully, I'll give him that."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Didn't charge, either."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Merribell, without letting go of the wrist, looks"]},{"code":401,"indent":0,"parameters":["at the way you are standing."]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] And you came off a ladder in"]},{"code":401,"indent":0,"parameters":["the spring, and told nobody."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Bram looks at the ceiling. There is a hatch in it,"]},{"code":401,"indent":0,"parameters":["and a ladder up to it, and he looks away from that"]},{"code":401,"indent":0,"parameters":["too."]},{"code":122,"indent":0,"parameters":[7,7,1,0,1]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] There is nothing wrong with you,"]},{"code":401,"indent":0,"parameters":["Mr Frayne. That's the trouble."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She looks at the book, and at the shelf of tonics"]},{"code":401,"indent":0,"parameters":["with other people's names on them, and at the"]},{"code":401,"indent":0,"parameters":["twelfth line, ruled and dated and empty."]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] I am not going to raise you a"]},{"code":401,"indent":0,"parameters":["twelfth time. Nobody is."]},{"code":401,"indent":0,"parameters":["That is the treatment."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] But who'll come by?"]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] The parish. Ask them to tea."]},{"code":401,"indent":0,"parameters":["Through the door. On purpose."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] You can do that?"]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] People do it every day, and"]},{"code":401,"indent":0,"parameters":["they don't fall off anything first."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He thinks about this for a long time."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Then you'll have the jar."]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] I will not."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] It says for whoever is going"]},{"code":401,"indent":0,"parameters":["that way. You're going that way."]},{"code":401,"indent":0,"parameters":["You said."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He cuts the string with the bread knife and tips it"]},{"code":401,"indent":0,"parameters":["out on the table: a hundred crowns for every one of"]},{"code":401,"indent":0,"parameters":["the eleven, put by for thirty years for whoever"]},{"code":401,"indent":0,"parameters":["would not take it."]},{"code":125,"indent":0,"parameters":[0,0,1100]},{"code":249,"indent":0,"parameters":[{"name":"Item","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Got \\C[3]1,100 crowns\\C[0]."]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] ...Thank you, Mr Frayne."]},{"code":101,"indent":0,"parameters":["Actor1",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Merribell:\\C[0] Now we leave. That's the"]},{"code":401,"indent":0,"parameters":["other half of it."]},{"code":122,"indent":0,"parameters":[2,2,1,0,1]},{"code":121,"indent":0,"parameters":[123,123,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"rep