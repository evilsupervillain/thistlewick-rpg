{"id":2,"name":"Tobias Frayne","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People3","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Visitors! Come in, come in."]},{"code":401,"indent":0,"parameters":["Mind the ladder. Well - don't mind it."]},{"code":401,"indent":0,"parameters":["Stand wherever you like."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask what is wrong with the ladder."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Third rung. Goes like a biscuit."]},{"code":401,"indent":0,"parameters":["Thirty years I've meant to mend it,"]},{"code":401,"indent":0,"parameters":["and it's never quite been the moment."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask how many times it has gone."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] The ladder? Four. The well's two,"]},{"code":401,"indent":0,"parameters":["the bull's two, the cliff's one, and"]},{"code":401,"indent":0,"parameters":["two I'd sooner not go into, because"]},{"code":401,"indent":0,"parameters":["I was in a hurry and it was silly."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You add them up, and ask whether he means"]},{"code":401,"indent":0,"parameters":["he has died eleven times."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Oh, nobody DIES on the coast road."]},{"code":401,"indent":0,"parameters":["Somebody always comes by. Adventurers."]},{"code":401,"indent":0,"parameters":["They're going that way anyway, they say."]},{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] And they're ever so kind about it."]},{"code":401,"indent":0,"parameters":["Kneel down. Hold your hand."]},{"code":401,"indent":0,"parameters":["Ask your name. Ask it twice, sometimes."]},{"code":401,"indent":0,"parameters":["You don't get that from the parish."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He glances at the ladder. Then at you."]},{"code":401,"indent":0,"parameters":["Then, quite fondly, at the ladder."]},{"code":122,"indent":0,"parameters":[2,2,1,0,1]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People3","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Gen_People3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Tobias:\\C[0] Staying for tea? I might just pop up"]},{"code":401,"indent":0,"parameters":["the ladder while the kettle's on."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He does not go up the ladder. He only"]},{"code":401,"indent":0,"parameters":["wants you to know that he could."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":11,"y":7},
{"id":3,"name":"The Ladder","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A ladder up to a hatch in the ceiling."]},{"code":401,"indent":0,"parameters":["The third rung is cracked clean through."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A new rung leans against the wall beside it,"]},{"code":401,"indent":0,"parameters":["planed, sound, and still in its paper."]},{"code":401,"indent":0,"parameters":["The paper has gone yellow."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":5,"y":4},
{"id":4,"name":"The Book","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A book, open on the table and ruled in"]},{"code":401,"indent":0,"parameters":["four columns: WHEN, WHAT, WHO, REMARKS."]},{"code":401,"indent":0,"parameters":["Eleven entries, in thirty years."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["  Ladder. A paladin. Very kind."]},{"code":401,"indent":0,"parameters":["  Well. Two elves. Sang to me."]},{"code":401,"indent":0,"parameters":["  Bull. A cleric. Cried a bit."]},{"code":401,"indent":0,"parameters":["  Ladder. Same paladin. Less kind."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["  Cliff. Four of them. Carried me up."]},{"code":401,"indent":0,"parameters":["  Ladder. A wizard. Did it from the gate."]},{"code":401,"indent":0,"parameters":["  Bull. Same cleric. Laughed this time."]},{"code":401,"indent":0,"parameters":["and four more in the same hand."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Every remark in the last column is some"]},{"code":401,"indent":0,"parameters":["way of saying 'lovely'."]},{"code":401,"indent":0,"parameters":["The twelfth line is ruled, and dated"]},{"code":401,"indent":0,"parameters":["today, and has nothing in it yet."]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":true,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["WHEN, WHAT, WHO, REMARKS."]},{"code":401,"indent":0,"parameters":["The twelfth line is still empty. He has"]},{"code":401,"indent":0,"parameters":["left the pen beside it, uncapped."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":true,"trigger":0,"walkAnime":true}],"x":7,"y":6},
