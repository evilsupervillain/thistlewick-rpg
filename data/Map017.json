{"id":2,"name":"Halbert Quy (#45)","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"People4","direction":8,"pattern":1,"characterIndex":4},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A man in his seventies is potting something"]},{"code":401,"indent":0,"parameters":["on the kitchen table. He is exactly as tall"]},{"code":401,"indent":0,"parameters":["as the portraits in Prophecy Hall and about"]},{"code":401,"indent":0,"parameters":["four stone heavier."]},{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] Thistlewick."]},{"code":401,"indent":0,"parameters":["I can tell from the standing."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You say who you are."]},{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] Forty-eight. Well."]},{"code":401,"indent":0,"parameters":["Halbert Quy. Forty-five."]},{"code":401,"indent":0,"parameters":["Sit down, you're blocking the light."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask why nobody in Thistlewick has ever"]},{"code":401,"indent":0,"parameters":["mentioned that he is alive."]},{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] Clause nineteen. The Resettlement"]},{"code":401,"indent":0,"parameters":["Clause. You come back, they give you a"]},{"code":401,"indent":0,"parameters":["pension and a cottage and 'such distance"]},{"code":401,"indent":0,"parameters":["from the village as is mutually agreeable'."]},{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] Turned out to be forty miles."]},{"code":401,"indent":0,"parameters":["They're not cruel. They're embarrassed."]},{"code":401,"indent":0,"parameters":["A hero who came back asks questions."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He turns the pot a quarter turn and looks"]},{"code":401,"indent":0,"parameters":["at it."]},{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] I asked one at the next meeting."]},{"code":401,"indent":0,"parameters":["I said: if it works every hundred years,"]},{"code":401,"indent":0,"parameters":["why is there always a next one?"]},{"code":401,"indent":0,"parameters":["Cottage was ready by the Friday."]},{"code":121,"indent":0,"parameters":[45,45,0]},{"code":122,"indent":0,"parameters":[2,2,1,0,1]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"People4","direction":8,"pattern":1,"characterIndex":4},"list":[{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] You want to know what he's like."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You do."]},{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] Polite. Tired. Very well read."]},{"code":401,"indent":0,"parameters":["He offered me tea and I said no because"]},{"code":401,"indent":0,"parameters":["I thought it was a trick, and it wasn't,"]},{"code":401,"indent":0,"parameters":["and I've thought about that tea ever since."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He puts the trowel down."]},{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] Here's the thing I came home with,"]},{"code":401,"indent":0,"parameters":["forty-eight, and it's the only thing"]},{"code":401,"indent":0,"parameters":["I've got that's worth the trip."]},{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] Nobody asks him why."]},{"code":401,"indent":0,"parameters":["Forty-seven of us. Forty-seven."]},{"code":401,"indent":0,"parameters":["We all did the sword. Not one of us"]},{"code":401,"indent":0,"parameters":["ever asked the man why he doesn't stop."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He looks at you for a while."]},{"code":101,"indent":0,"parameters":["People4",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Halbert Quy:\\C[0] Ask him. That's all. Ask him why."]},{"code":401,"indent":0,"parameters":["And then listen to the whole answer,"]},{"code":401,"indent":0,"parameters":["because it's long, and because I didn't."]},{"code":121,"indent":0,"parameters":[43,43,0]},{"code":122,"indent":0,"parameters":[2,2,1,0,1]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A"