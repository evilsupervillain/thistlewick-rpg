{"id":2,"name":"The Book","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The Book lies open on the lectern, and it glows:"]},{"code":401,"indent":0,"parameters":["a soft, even light with nothing to account for it."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The page is in a great many hands. Most of them"]},{"code":401,"indent":0,"parameters":["are the same hand."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["  Sir Dunstable of the Vale. Just in case."]},{"code":401,"indent":0,"parameters":["  Sir Dunstable of the Vale. Just in case."]},{"code":401,"indent":0,"parameters":["  Sir Dunstable of the Vale. Just in case."]},{"code":401,"indent":0,"parameters":["  Sir Dunstable of the Vale. Just in case."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["  Mr & Mrs Tolley, just married. In case."]},{"code":401,"indent":0,"parameters":["  Mr & Mrs Tolley. Again. So sorry, Brother."]},{"code":401,"indent":0,"parameters":["  Mr & Mrs Tolley. Again!"]},{"code":401,"indent":0,"parameters":["  Sir Dunstable of the Vale. Just in case."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Brother Quillon's smile does not change. It is the"]},{"code":401,"indent":0,"parameters":["smile of a man not reacting to anything."]},{"code":122,"indent":0,"parameters":[7,7,1,0,1]},{"code":123,"indent":0,"parameters":["B",0]},{"code":101,"indent":0,"parameters":["Gen_People2",0,0,2,""]},{"code":401,"indent":0,"pa