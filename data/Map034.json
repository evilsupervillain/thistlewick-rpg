{"id":3,"name":"Brother Quillon","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People2","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Gen_People2",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Quillon:\\C[0] Welcome, traveller."]},{"code":401,"indent":0,"parameters":["Brother Quillon. I keep the Record."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask what the Record is for."]},{"code":101,"indent":0,"parameters":["Gen_People2",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Quillon:\\C[0] Those going into the mountain"]},{"code":401,"indent":0,"parameters":["write their names in the Book."]},{"code":401,"indent":0,"parameters":["In case of misfortune."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask what happens in case of misfortune."]},{"code":101,"indent":0,"parameters":["Gen_People2",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Quillon:\\C[0] They come back in through the porch,"]},{"code":401,"indent":0,"parameters":["and write their names again."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask whether he remembers them."]},{"code":101,"indent":0,"parameters":["Gen_People2",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Quillon:\\C[0] The Order forbids it, traveller."]},{"code":401,"indent":0,"parameters":["It is the only thing the Order forbids."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He smiles, serenely, with his eyes shut. It is a"]},{"code":401,"indent":0,"parameters":["very expressive smile. It has had