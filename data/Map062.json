{"id":2,"name":"Prime Warden","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People6","direction":2,"pattern":1,"characterIndex":1},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A tall woman in black, with iron-grey hair pinned up and"]},{"code":401,"indent":0,"parameters":["gold at her collar, standing at the Company's table as if"]},{"code":401,"indent":0,"parameters":["it might try something."]},{"code":101,"indent":0,"parameters":["Gen_People6",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prime Warden:\\C[0] Stannard. Prime"]},{"code":401,"indent":0,"parameters":["Warden of the Worshipful Company of"]},{"code":401,"indent":0,"parameters":["Smiths of Great Dunnage."]},{"code":101,"indent":0,"parameters":["Gen_People6",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prime Warden:\\C[0] Are you a smith?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You say that you are a turnip farmer."]},{"code":101,"indent":0,"parameters":["Gen_People6",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prime Warden:\\C[0] Then you may look."]},{"code":401,"indent":0,"parameters":["Do not touch. The Assize is in the"]},{"code":401,"indent":0,"parameters":["spring. It is every three years."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask what the Assize is."]},{"code":101,"indent":0,"parameters":["Gen_People6",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prime Warden:\\C[0] Every smith in the"]},{"code":401,"indent":0,"parameters":["land may submit one piece, to be"]},{"code":401,"indent":0,"parameters":["judged by the Wardens against the"]},{"code":401,"indent":0,"parameters":["Schedule."]},{"code":101,"indent":0,"parameters":["Gen_People6",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prime Warden:\\C[0] Very few manage to"]},{"code":401,"indent":0,"parameters":["submit one. It is a very good"]},{"code":401,"indent":0,"parameters":["Schedule."]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People6","direction":2,"pattern":1,"characterIndex":1},"list":[{"code":101,"indent":0,"parameters":["Gen_People6",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prime Warden:\\C[0] Look. Do not"]},{"code":401,"indent":0,"parameters":["touch. The Schedule is on the wall."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":10,"y":6},
