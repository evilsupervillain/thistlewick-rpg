{"id":4,"name":"The Schedule","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["THE SCHEDULE OF WHAT CONSTITUTES A PIECE, being the rules of"]},{"code":401,"indent":0,"parameters":["the Assize of Hammers, in forty-one clauses, of which:"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["1. A piece shall be the entrant's own work, from the ore up."]},{"code":401,"indent":0,"parameters":["2. A piece shall be the entrant's own property."]},{"code":401,"indent":0,"parameters":["3. A hinge is a piece. Half a hinge is not a piece. A pair"]},{"code":401,"indent":0,"parameters":["of hinges is two pieces, unless submitted as a door."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["41. The decision of the Wardens is final, and so is the"]},{"code":401,"indent":0,"parameters":["Schedule."]},{"code":111,"indent":0,"parameters":[4,3,0]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Hob reads it all the way down, slowly, with one finger, and"]},{"code":401,"indent":1,"parameters":["then goes back up to clause two and reads that again."]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["He says nothing at all. On the way past the door he looks"]},{"code":401,"indent":1,"parameters":["at its hinges, for a while."]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"