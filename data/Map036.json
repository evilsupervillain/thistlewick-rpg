{"id":2,"name":"Princess Rosamund","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People2","direction":2,"pattern":1,"characterIndex":3},"list":[{"code":101,"indent":0,"parameters":["Gen_People2",3,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Rosamund:\\C[0] Oh, are you the rescue? Lovely."]},{"code":401,"indent":0,"parameters":["Could you carry the cake tin?"]},{"code":401,"indent":0,"parameters":["Mind the seventh stair,"]},{"code":401,"indent":0,"parameters":["it's a trap."]},{"code":101,"indent":0,"parameters":["Gen_People2",3,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Rosamund:\\C[0] The eighth is also a trap."]},{"code":401,"indent":0,"parameters":["The ninth is fine."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You say you are not the rescue. You are only passing."]},{"code":101,"indent":0,"parameters":["Gen_People2",3,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Rosamund:\\C[0] Oh! Well, that's a relief,"]},{"code":401,"indent":0,"parameters":["honestly. It's Thursday."]},{"code":101,"indent":0,"parameters":["Gen_People2",3,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Rosamund:\\C[0] I go up the hill on Thursdays."]},{"code":401,"indent":0,"parameters":["Mrs Emberthwaite does a lovely"]},{"code":401,"indent":0,"parameters":["sponge, and she cheats at whist."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask whether she is not afraid of the dragon."]},{"code":101,"indent":0,"parameters":["Gen_People2",3,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Rosamund:\\C[0] Of Mrs Emberthwaite? She's"]},{"code":401,"indent":0,"parameters":["seventy. The first time I was"]},{"code":401,"indent":0,"parameters":["carried up there, she made up"]},{"code":401,"indent":0,"parameters":["the spare room."]},{"code":101,"indent":0,"parameters":["Gen_People2",3,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Rosamund:\\C[0] She said she hadn't had anybody"]},{"code":401,"indent":0,"parameters":["to talk to since Mr Emberthwaite."]},{"code":401,"indent":0,"parameters":["So now I walk. It's quicker."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Eleven times, she says, she has been kidnapped."]},{"code":401,"indent":0,"parameters":["Twelve, if you count the eagle, which the Palace"]},{"code":401,"indent":0,"parameters":["does not."]},{"code":122,"indent":0,"parameters":[2,2,1,0,1]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People2","direction":2,"pattern":1,"characterIndex":3},"list":[{"code":101,"indent":0,"parameters":["Gen_People2",3,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Rosamund:\\C[0] It's the bag by the window,"]},{"code":401,"indent":0,"parameters":["if anybody asks. It is always"]},{"code":401,"indent":0,"parameters":["the bag by the window."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":5,