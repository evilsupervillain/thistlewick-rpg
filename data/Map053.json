{"id":2,"name":"Mrs Ash","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People4","direction":4,"pattern":1,"characterIndex":7},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A kitchen so new that the paint still smells of it, with"]},{"code":401,"indent":0,"parameters":["a big window over the lake. A woman at the table is"]},{"code":401,"indent":0,"parameters":["knitting something long, and does not stop."]},{"code":101,"indent":0,"parameters":["Gen_People4",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mrs Ash:\\C[0] Hello, dear! Come in, come in."]},{"code":401,"indent":0,"parameters":["Mind the step. It's new. It's all new."]},{"code":401,"indent":0,"parameters":["Isn't it lovely?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You say that you are the Chosen One. Number forty-eight."]},{"code":101,"indent":0,"parameters":["Gen_People4",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mrs Ash:\\C[0] How nice. Sit down, I'll put"]},{"code":401,"indent":0,"parameters":["the kettle on. It's a new kettle."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask, carefully, about the flood."]},{"code":101,"indent":0,"parameters":["Gen_People4",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mrs Ash:\\C[0] Oh, the flood. It was a Tuesday."]},{"code":401,"indent":0,"parameters":["We all went up the hill with the kettles,"]},{"code":401,"indent":0,"parameters":["and by teatime we'd decided to build it"]},{"code":401,"indent":0,"parameters":["again, only better."]},{"code":101,"indent":0,"parameters":["Gen_People4",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mrs Ash:\\C[0] The old kitchen was DARK. You"]},{"code":401,"indent":0,"parameters":["couldn't see your potatoes. Look at the"]},{"code":401,"indent":0,"parameters":["light in here. I can see every potato"]},{"code":401,"indent":0,"parameters":["I own."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask whether she has family."]},{"code":101,"indent":0,"parameters":["Gen_People4",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mrs Ash:\\C[0] My boy's away. He wrote to say"]},{"code":401,"indent":0,"parameters":["he'd taken the name Ash, after the"]},{"code":401,"indent":0,"parameters":["village, in its memory. Well, I thought,"]},{"code":401,"indent":0,"parameters":["that's nice."]},{"code":101,"indent":0,"parameters":["Gen_People4",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mrs Ash:\\C[0] So I took it as well, to save"]},{"code":401,"indent":0,"parameters":["the postman. Now we're all Ashes, and"]},{"code":401,"indent":0,"parameters":["the post comes lovely. He's very deep,"]},{"code":401,"indent":0,"parameters":["my boy."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The knitting has got longer while she talks. You ask who"]},{"code":401,"indent":0,"parameters":["it is for."]},{"code":101,"indent":0,"parameters":["Gen_People4",7,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mrs Ash:\\C[0] Somebody who feels the cold"]},{"code":401,"indent":0,"parameters":["and won't say so."]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":f