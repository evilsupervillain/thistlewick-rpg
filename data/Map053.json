{"id":5,"name":"Hubert Weir","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People5","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A man in a coat with gold frogging stands in the middle of"]},{"code":401,"indent":0,"parameters":["the room with his hands behind his back, the way a man"]},{"code":401,"indent":0,"parameters":["stands in a room he is proud of."]},{"code":101,"indent":0,"parameters":["Gen_People5",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mr Weir:\\C[0] Welcome to the Ashcombe"]},{"code":401,"indent":0,"parameters":["Drainage Museum! Hubert Weir, Curator."]},{"code":401,"indent":0,"parameters":["Admission is free. So is the enthusiasm."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You say that you are the Chosen One. Number forty-eight."]},{"code":101,"indent":0,"parameters":["Gen_People5",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mr Weir:\\C[0] Splendid! Then you'll want the drains."]},{"code":101,"indent":0,"parameters":["Gen_People5",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mr Weir:\\C[0] Fourteen hundred yards of culvert,"]},{"code":401,"indent":0,"parameters":["a fall of one in two hundred, and not one"]},{"code":401,"indent":0,"parameters":["puddle in Ashcombe since the day they"]},{"code":401,"indent":0,"parameters":["went in."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask about the flood."]},{"code":101,"indent":0,"parameters":["Gen_People5",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mr Weir:\\C[0] A tremendous success. Everybody"]},{"code":401,"indent":0,"parameters":["out by dinner, everybody dry by tea, and"]},{"code":401,"indent":0,"parameters":["not so much as a hen lost. We have the"]},{"code":401,"indent":0,"parameters":["Roll."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You mention that you had heard the new village was eight"]},{"code":401,"indent":0,"parameters":["miles inland."]},{"code":101,"indent":0,"parameters":["Gen_People5",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mr Weir:\\C[0] By the ROAD, sir. The road goes"]},{"code":401,"indent":0,"parameters":["all the way round the lake. As the crow"]},{"code":401,"indent":0,"parameters":["flies, you could skim a stone on to the"]},{"code":401,"indent":0,"parameters":["old church roof."]},{"code":111,"indent":0,"parameters":[4,8,0]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Mr Weir's eye passes over the hooded man behind you, and"]},{"code":401,"indent":1,"parameters":["moves on without stopping."]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Corvin is looking at the plan of the drains. After a"]},{"code":401,"indent":1,"parameters":["while, very quietly:"]},{"code":101,"indent":1,"parameters":["Actor1",4,0,2,""]},{"code":401,"indent":1,"parameters":["\\C[6]Corvin:\\C[0] ...They are good drains."]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableV