{"id":2,"name":"Mirabel","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People2","direction":2,"pattern":1,"characterIndex":4},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["On a stepstool in the middle of the Archive stands"]},{"code":401,"indent":0,"parameters":["a very small girl with long silver hair, a silver"]},{"code":401,"indent":0,"parameters":["circlet, and the look of somebody who has seen all"]},{"code":401,"indent":0,"parameters":["of this before."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She has. She is the Last Oracle of Olde Evermore,"]},{"code":401,"indent":0,"parameters":["and she is four thousand one hundred and twelve."]},{"code":101,"indent":0,"parameters":["Nature",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Elder Lirien:\\C[0] And a quarter."]},{"code":401,"indent":0,"parameters":["She likes the quarter mentioned."]},{"code":101,"indent":0,"parameters":["Gen_People2",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mirabel:\\C[0] Eight and a QUARTER."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She lifts her hands. Every candle in the Archive"]},{"code":401,"indent":0,"parameters":["leans towards her. She speaks in the Old Tongue,"]},{"code":401,"indent":0,"parameters":["and it is flawless, and it is terrible."]},{"code":101,"indent":0,"parameters":["Nature",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Elder Lirien:\\C[0] \"When the moon devours the sun,"]},{"code":401,"indent":0,"parameters":["and the last bell falls silent,"]},{"code":401,"indent":0,"parameters":["the one who was not chosen shall...\""]},{"code":101,"indent":0,"parameters":["Gen_People2",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mirabel:\\C[0] ...is that a biscuit?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["It is. It is in your pocket. You had forgotten it"]},{"code":401,"indent":0,"parameters":["was there. She had not."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You give her the biscuit. The prophecy does not"]},{"code":401,"indent":0,"parameters":["get finished, and nobody seems to mind."]},{"code":101,"indent":0,"parameters":["Nature",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Elder Lirien:\\C[0] It never does. She's been doing"]},{"code":401,"indent":0,"parameters":["that one since the Second Age."]},{"code":401,"indent":0,"parameters":["It's always a biscuit."]},{"code":122,"indent":0,"parameters":[2,2,1,0,1]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People2","direction":2,"pattern":1,"characterIndex":4},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask about the Prophecy of Thistlewick."]},{"code":101,"indent":0,"parameters":["Gen_People2",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mirabel:\\C[0] I was there when they signed it."]},{"code":401,"indent":0,"parameters":["It was ever so long. Everybody had"]},{"code":401,"indent":0,"parameters":["to sign it three times."]},{"code":101,"indent":0,"parameters":["Gen_People2",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mirabel:\\C[0] So I drew a horse on it."]},{"code":101,"indent":0,"parameters":["Actor3",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Elder Faelan:\\C[0] In the margin. Of a sacred and"]},{"code":401,"indent":0,"parameters":["binding instrument. Grandmother."]},{"code":101,"indent":0,"parameters":["Gen_People2",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mirabel:\\C[0] It's a good horse."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask her who the villain really is."]},{"code":101,"indent":0,"parameters":["Gen_People2",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mirabel:\\C[0] I know. I'm not allowed to SAY."]},{"code":401,"indent":0,"parameters":["I'll draw it."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She draws for a long time, with her tongue out of"]},{"code":401,"indent":0,"parameters":["the corner of her mouth, and then she shows you."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["It is a horse."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You say, carefully, that it is a very good horse."]},{"code":101,"indent":0,"parameters":["Gen_People2",4,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Mirabel:\\C[0] It's not a horse. It's the villain."]},{"code":401,"indent":0,"parameters":["I'm only very good at horses."]},{"code":123,"indent":0,"parameters":["B",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"B