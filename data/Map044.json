{"id":9,"name":"Perce Stagg","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People3","direction":2,"pattern":1,"characterIndex":1},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["An old man in a red coat with a white fur collar,"]},{"code":401,"indent":0,"parameters":["standing beside the ribbon post as though it"]},{"code":401,"indent":0,"parameters":["might need him."]},{"code":101,"indent":0,"parameters":["Gen_People3",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Perce:\\C[0] Hello! You've come for the Festival?"]},{"code":401,"indent":0,"parameters":["It's not till the twelfth."]},{"code":401,"indent":0,"parameters":["Everybody comes early."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask whether he is the man who broke the winter."]},{"code":101,"indent":0,"parameters":["Gen_People3",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Perce:\\C[0] I am. Percival Stagg. Perce."]},{"code":401,"indent":0,"parameters":["Forty years ago this spring."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A lady with a basket goes by and says 'Our Chosen"]},{"code":401,"indent":0,"parameters":["One!' He does a face: warm, modest, and very"]},{"code":401,"indent":0,"parameters":["well practised."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You mention, as one professional to another,"]},{"code":401,"indent":0,"parameters":["that you are a Chosen One yourself."]},{"code":401,"indent":0,"parameters":["Number forty-eight."]},{"code":101,"indent":0,"parameters":["Gen_People3",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Perce:\\C[0] Are you! Well. Good for you."]},{"code":401,"indent":0,"parameters":["I wasn't, you know. Chosen."]},{"code":401,"indent":0,"parameters":["Nobody chose me."]},{"code":101,"indent":0,"parameters":["Gen_People3",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Perce:\\C[0] Everybody went north, that year."]},{"code":401,"indent":0,"parameters":["Farmers, tinkers, a man with a goat."]},{"code":401,"indent":0,"parameters":["I got as far as here, and the winter"]},{"code":401,"indent":0,"parameters":["was in the way, so I saw to it."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask why he has never said so."]},{"code":101,"indent":0,"parameters":["Gen_People3",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Perce:\\C[0] Nobody's ever asked."]},{"code":401,"indent":0,"parameters":["They were all so pleased."]},{"code":401,"indent":0,"parameters":["And it's a lovely Festival."]},{"code":122,"indent":0,"parameters":[2,2,1,0,1]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People3","direction":2,"pattern":1,"characterIndex":1},"list":[{"code":101,"indent":0,"parameters":["Gen_People3",1,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Perce:\\C[0] The twelfth. Ribbon at noon."]},{"code":401,"indent":0,"parameters":["I'll do the face. You'll see."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"