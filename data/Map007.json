ndent":0,"parameters":["Supplied",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Nix:\\C[0] Eleven things I never did. They've been in"]},{"code":401,"indent":0,"parameters":["the book since the first page. The longest"]},{"code":401,"indent":0,"parameters":["loans I've got."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask whether they were loans."]},{"code":101,"indent":0,"parameters":["Supplied",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Nix:\\C[0] Everything's a loan, eventually."]},{"code":401,"indent":0,"parameters":["That's what the RETURNED column is for."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The RETURNED column has been ruled, very neatly,"]},{"code":401,"indent":0,"parameters":["down eleven years of pages. There is nothing in it."]},{"code":101,"indent":0,"parameters":["Supplied",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Nix:\\C[0] Here: your mother's pie dish. The old"]},{"code":401,"indent":0,"parameters":["man's chair. The fisher's keep net."]},{"code":401,"indent":0,"parameters":["The gate key."]},{"code":101,"indent":0,"parameters":["Supplied",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Nix:\\C[0] Nether Sopping: the ferryman's tide table,"]},{"code":401,"indent":0,"parameters":["the councillor's spectacles, Tolly's stamps"]},{"code":401,"indent":0,"parameters":["and Hulda Bole's good boots."]},{"code":101,"indent":0,"parameters":["Supplied",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Nix:\\C[0] Clanging: Old Sowerby's snap tin, a"]},{"code":401,"indent":0,"parameters":["small oil can for the Hoyle Works, and a"]},{"code":401,"indent":0,"parameters":["cradle for Bessie Marsden."]},{"code":401,"indent":0,"parameters":["One afternoon. Easy."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["It will not be one afternoon."]},{"code":122,"indent":0,"parameters":[2,2,1,0,1]},{"code":126,"indent":0,"parameters":[46,0,0,11,false]},{"code":249,"indent":0,"parameters":[{"name":"Item","volume":90,"pitch":100,"pan":0}]},{"code":121,"indent":0,"parameters":[127,127,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Got \\I[209]\\C[3]Previously Owned Goods\\C[0] x11."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":5,"actorValid":true,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":127,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Supplied",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Nix:\\C[0] \\V[17] of eleven back."]},{"code":401,"indent":0,"parameters":["The column's filling up."]},{"code":111,"indent":0,"parameters":[8,46]},{"code":101,"indent":1,"parameters":["Supplied",0,0,2,""]},{"code":401,"indent":1,"parameters":["\\C[6]Nix:\\C[0] The rest are in the bag, labelled."]},{"code":401,"indent":1,"parameters":["Here, Nether Sopping, and up in Clanging."]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":5,"actorValid":true,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":127,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":17,"vari