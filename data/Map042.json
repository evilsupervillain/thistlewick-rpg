{"id":2,"name":"Hollowell","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People2","direction":2,"pattern":1,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A man in a pressed suit is standing in the middle"]},{"code":401,"indent":0,"parameters":["of the hall with a feather duster. He sees you,"]},{"code":401,"indent":0,"parameters":["and his whole face lights up."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] Visitors! Oh, VISITORS."]},{"code":401,"indent":0,"parameters":["Come in, come in, mind the step - no,"]},{"code":401,"indent":0,"parameters":["there isn't one. Force of habit."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] Prosper Hollowell. Caretaker."]},{"code":401,"indent":0,"parameters":["Retained. Welcome to the Former"]},{"code":401,"indent":0,"parameters":["Premises!"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He shakes your hand. He shakes everybody's hand."]},{"code":401,"indent":0,"parameters":["He comes back and shakes yours again, in case it"]},{"code":401,"indent":0,"parameters":["did not take."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] You came by AIR. Of course you did."]},{"code":401,"indent":0,"parameters":["It's the only way. That was rather"]},{"code":401,"indent":0,"parameters":["the whole point of the place."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] The tour starts here. It also ends"]},{"code":401,"indent":0,"parameters":["here. It's one hall. I've been"]},{"code":401,"indent":0,"parameters":["working on it."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask what this place was."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] The venue! Two thousand years of"]},{"code":401,"indent":0,"parameters":["Dark Lords, raised up here by"]},{"code":401,"indent":0,"parameters":["somebody's grandfather so that no"]},{"code":401,"indent":0,"parameters":["hero could ever reach it."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] And no hero ever did."]},{"code":401,"indent":0,"parameters":["It worked perfectly. Not one."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He beams, as if this is the best news he has had"]},{"code":401,"indent":0,"parameters":["in years. It may be."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] Then there was a complaint, about"]},{"code":401,"indent":0,"parameters":["the climb. Then a second one. Then"]},{"code":401,"indent":0,"parameters":["a recommendation."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] So they moved it all into a tower,"]},{"code":401,"indent":0,"parameters":["with a door at the bottom. Ground"]},{"code":401,"indent":0,"parameters":["floor. Very sensible. The heroes"]},{"code":401,"indent":0,"parameters":["have to be able to ARRIVE, you see."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] That was four thousand eight hundred"]},{"code":401,"indent":0,"parameters":["years ago. I was retained. I've kept"]},{"code":401,"indent":0,"parameters":["it ready ever since, in case it's"]},{"code":401,"indent":0,"parameters":["re-let."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] And the complaint was upheld! They"]},{"code":401,"indent":0,"parameters":["put in a lift. Courtyard to the"]},{"code":401,"indent":0,"parameters":["battlements. It works beautifully."]},{"code":401,"indent":0,"parameters":["It always has."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask whether anybody has visited, in four"]},{"code":401,"indent":0,"parameters":["thousand eight hundred years."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] Not a soul! Everything's in perfect"]},{"code":401,"indent":0,"parameters":["working order. Which brings me to"]},{"code":401,"indent":0,"parameters":["the visitors' book."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] Four thousand eight hundred years,"]},{"code":401,"indent":0,"parameters":["and nobody in it. It's the one gap in"]},{"code":401,"indent":0,"parameters":["the record. And you're going up the"]},{"code":401,"indent":0,"parameters":["tower, aren't you? You've the look."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] Would you ask the current incumbent"]},{"code":401,"indent":0,"parameters":["to sign it? For the file?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You say that you will ask."]},{"code":101,"indent":0,"parameters":["Gen_People2",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Hollowell:\\C[0] Splendid. SPLENDID. The book doesn't"]},{"code":401,"indent":0,"parameters":["leave the lectern - it never has -"]},{