{"id":2,"name":"Prewitt","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People5","direction":2,"pattern":1,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["A woman in a navy jacket and a tie, at a desk with nothing"]},{"code":401,"indent":0,"parameters":["on it but an hourglass and a very large ledger."]},{"code":101,"indent":0,"parameters":["Gen_People5",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prewitt:\\C[0] Good afternoon."]},{"code":401,"indent":0,"parameters":["Prewitt, Sub-Librarian. How may the"]},{"code":401,"indent":0,"parameters":["Library help you?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask whether you might borrow a book."]},{"code":101,"indent":0,"parameters":["Gen_People5",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prewitt:\\C[0] Of course. You'll"]},{"code":401,"indent":0,"parameters":["need a reader's ticket. The Library"]},{"code":401,"indent":0,"parameters":["issues them on a letter from a Fellow."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You show her Mr Gedge's card."]},{"code":101,"indent":0,"parameters":["Gen_People5",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prewitt:\\C[0] Mr Gedge is not a"]},{"code":401,"indent":0,"parameters":["Fellow. Mr Gedge is a great deal more"]},{"code":401,"indent":0,"parameters":["than a Fellow, and the Library cannot"]},{"code":401,"indent":0,"parameters":["accept his letters on that account."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You ask whether that is a no."]},{"code":101,"indent":0,"parameters":["Gen_People5",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prewitt:\\C[0] Oh, it is never a"]},{"code":401,"indent":0,"parameters":["no. Nothing here is ever a no. It is"]},{"code":401,"indent":0,"parameters":["\"not from this desk\"."]},{"code":101,"indent":0,"parameters":["Gen_People5",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prewitt:\\C[0] I can refer you to"]},{"code":401,"indent":0,"parameters":["the Committee for Readers. It meets in"]},{"code":401,"indent":0,"parameters":["the Library, so its members must all"]},{"code":401,"indent":0,"parameters":["hold a reader's ticket."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She says it kindly, and correctly, and she does not move"]},{"code":401,"indent":0,"parameters":["at all."]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Gen_People5","direction":2,"pattern":1,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["Gen_People5",6,0,2,""]},{"code":401,"indent":0,"parameters":["\\C[6]Prewitt:\\C[0] Not from this desk."]},{"code":401,"indent":0,"parameters":["But I can refer you, which is very"]},{"code":401,"indent":0,"parameters":["nearly the same, and takes longer."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"ste